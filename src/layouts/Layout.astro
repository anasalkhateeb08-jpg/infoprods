---
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  keywords?: string;
}

const {
  title,
  description,
  image = '/ip-logo.png',
  type = 'website',
  keywords = 'product reviews, shopping, technology, fashion, beauty, home decor'
} = Astro.props;

const siteURL = Astro.site || 'https://infoprods.com';
const ogImage = new URL(image, siteURL);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
---

<!DOCTYPE html>
<html lang="en">
<head>
<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JNB5SYLFSN"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-JNB5SYLFSN');
</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="verify-admitad" content="9595e9e17a" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title}>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="InfoProds">
  <link rel="canonical" href={canonicalURL}>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:site_name" content="InfoProds">
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonicalURL}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={ogImage}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/ip-logo.png">
  
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "InfoProds",
    "url": siteURL,
    "description": "Your space for the right information and products",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${siteURL}/search?q={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  })} />
  
  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "InfoProds",
    "url": siteURL,
    "logo": ogImage.toString(),
    "description": "Your space for the right information and products",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "info@infoprods.com"
    }
  })} />
</head>
<body class="bg-gradient-to-b from-gray-900 to-black text-white min-h-screen flex flex-col">
  <Header />
  <main class="flex-grow">
    <slot />
  </main>
  
  <!-- Footer -->
  <footer class="bg-gray-900 border-t border-gray-800 mt-16">
    <div class="container mx-auto px-4 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- About Section -->
        <div>
          <h3 class="text-xl font-bold mb-4">InfoProds</h3>
          <p class="text-gray-400 text-sm">
            Your space for the right information and products. Discover reviews, comparisons, and guides.
          </p>
        </div>
        
        <!-- Quick Links -->
        <div>
          <h4 class="text-lg font-semibold mb-4">Quick Links</h4>
          <ul class="space-y-2">
            <li><a href="/" class="text-gray-400 hover:text-purple-400 text-sm transition">Home</a></li>
            <li><a href="/blog" class="text-gray-400 hover:text-purple-400 text-sm transition">Blog</a></li>
            <li><a href="/about" class="text-gray-400 hover:text-purple-400 text-sm transition">About Us</a></li>
            <li><a href="/contact" class="text-gray-400 hover:text-purple-400 text-sm transition">Contact</a></li>
          </ul>
        </div>
        
        <!-- Legal -->
        <div>
          <h4 class="text-lg font-semibold mb-4">Legal</h4>
          <ul class="space-y-2">
            <li><a href="/privacy-policy" class="text-gray-400 hover:text-purple-400 text-sm transition">Privacy Policy</a></li>
            <li><a href="/terms-of-service" class="text-gray-400 hover:text-purple-400 text-sm transition">Terms of Service</a></li>
          </ul>
        </div>
        
        <!-- Contact Info -->
        <div>
          <h4 class="text-lg font-semibold mb-4">Contact</h4>
          <ul class="space-y-2 text-gray-400 text-sm">
            <li>Email: info@infoprods.com</li>
          </ul>
        </div>
      </div>
      
      <!-- Copyright -->
      <div class="border-t border-gray-800 mt-8 pt-8 text-center">
        <p class="text-gray-500 text-sm">
          © {new Date().getFullYear()} InfoProds. All rights reserved.
        </p>
      </div>
    </div>
  </footer>
  

  <!-- Newsletter Pop-up Modal -->
  <div id="newsletterModal" class="hidden fixed inset-0 bg-black/70 z-[9999] flex items-center justify-center p-4">
    <div class="bg-gradient-to-br from-purple-600 to-blue-600 rounded-3xl p-8 max-w-md w-full relative shadow-2xl animate-fade-in">
      <button id="closeModal" class="absolute top-4 right-4 text-white hover:text-gray-200 text-3xl font-bold">&times;</button>
      
      <div class="text-center text-white">
        <div class="text-5xl mb-4">📧</div>
        <h2 class="text-3xl font-bold mb-2">Don't Miss Out!</h2>
        <p class="text-lg mb-6 opacity-90">Get expert product reviews and buying guides delivered to your inbox</p>
        
        <form action="https://infoprods.us14.list-manage.com/subscribe/post?u=31271582e5a8682479ad0e485&id=d43c2cdea4&f_id=009814e0f0" method="post" target="_blank" class="space-y-3">
          <input 
            type="email" 
            name="EMAIL" 
            placeholder="Enter your email" 
            required
            class="w-full px-4 py-3 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-white"
          >
          <div style="position: absolute; left: -5000px;" aria-hidden="true">
            <input type="text" name="b_31271582e5a8682479ad0e485_d43c2cdea4" tabindex="-1" value="">
          </div>
          <button 
            type="submit" 
            class="w-full px-6 py-3 bg-white text-purple-600 rounded-lg font-bold hover:bg-gray-100 transition"
          >
            Subscribe Now
          </button>
        </form>
        <p class="text-xs mt-3 opacity-75">We respect your privacy. Unsubscribe anytime.</p>
      </div>
    </div>
  </div>

  <script>
    // Pop-up appears after 30 seconds
    setTimeout(() => {
      const modal = document.getElementById('newsletterModal');
      const alreadyShown = localStorage.getItem('newsletterShown');
      
      if (!alreadyShown && modal) {
        modal.classList.remove('hidden');
        localStorage.setItem('newsletterShown', 'true');
      }
    }, 30000); // 30 seconds

    // Close modal
    const closeBtn = document.getElementById('closeModal');
    const modal = document.getElementById('newsletterModal');
    
    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });
    
    // Close on background click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });
  </script>

  <style>
    @keyframes fade-in {
      from {
        opacity: 0;
        transform: scale(0.9);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
    
    .animate-fade-in {
      animation: fade-in 0.3s ease-out;
    }
  </style>

</body>
</html>
