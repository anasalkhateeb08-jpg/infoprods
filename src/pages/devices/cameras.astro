---
import Layout from '../../layouts/Layout.astro';

const featuredImages = [
  "https://images.unsplash.com/photo-1502920917128-1aa500764cbd?w=800&h=600&fit=crop&q=80",
  "https://images.unsplash.com/photo-1606983340126-99ab4feaa64a?w=800&h=600&fit=crop&q=80",
  "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=800&h=600&fit=crop&q=80",
  "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=800&h=600&fit=crop&q=80",
];

const cameras = [
  {
    title: "Sony A7 IV: Full-Frame Excellence",
    excerpt: "Professional mirrorless camera with 33MP sensor and advanced autofocus system.",
    image: "https://images.unsplash.com/photo-1502920917128-1aa500764cbd?w=800&h=600&fit=crop&q=80",
    date: "Nov 20, 2024",
    readTime: "8 min read",
    author: "Photo Pro",
    specs: "33MP Full-Frame • 4K 60fps • 759-point AF",
    price: "$2,498"
  },
  {
    title: "Canon EOS R6 Mark II: Speed Demon",
    excerpt: "High-speed mirrorless with incredible low-light performance and 40fps shooting.",
    image: "https://images.unsplash.com/photo-1606983340126-99ab4feaa64a?w=800&h=600&fit=crop&q=80",
    date: "Nov 18, 2024",
    readTime: "7 min read",
    author: "Canon Expert",
    specs: "24MP Full-Frame • 6K RAW • Dual Pixel AF II",
    price: "$2,499"
  },
  {
    title: "Nikon Z8: Professional Powerhouse",
    excerpt: "Flagship mirrorless with 8K video and uncompromising image quality.",
    image: "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=800&h=600&fit=crop&q=80",
    date: "Nov 15, 2024",
    readTime: "8 min read",
    author: "Nikon Specialist",
    specs: "45.7MP Full-Frame • 8K 60fps • 493-point AF",
    price: "$3,996"
  },
  {
    title: "Fujifilm X-T5: APS-C Champion",
    excerpt: "Retro-styled mirrorless with stunning image quality and film simulations.",
    image: "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=800&h=600&fit=crop&q=80",
    date: "Nov 12, 2024",
    readTime: "6 min read",
    author: "Fuji Fan",
    specs: "40MP APS-C • 6.2K Video • Film Simulations",
    price: "$1,699"
  },
  {
    title: "Panasonic Lumix S5 II: Video Beast",
    excerpt: "Hybrid camera excelling in both photography and professional video production.",
    image: "https://images.unsplash.com/photo-1502920917128-1aa500764cbd?w=800&h=600&fit=crop&q=80",
    date: "Nov 10, 2024",
    readTime: "7 min read",
    author: "Video Pro",
    specs: "24MP Full-Frame • 6K Video • Phase Detect AF",
    price: "$1,997"
  },
  {
    title: "GoPro Hero 12: Action Camera King",
    excerpt: "Ultimate action camera with incredible stabilization and 5.3K video.",
    image: "https://images.unsplash.com/photo-1519638399535-1b036603ac77?w=800&h=600&fit=crop&q=80",
    date: "Nov 8, 2024",
    readTime: "5 min read",
    author: "Action Cam Pro",
    specs: "27MP • 5.3K 60fps • HyperSmooth 6.0",
    price: "$399"
  },
  {
    title: "DJI Osmo Pocket 3: Vlogging Perfection",
    excerpt: "Ultra-compact gimbal camera perfect for vloggers and content creators.",
    image: "https://images.unsplash.com/photo-1606983340126-99ab4feaa64a?w=800&h=600&fit=crop&q=80",
    date: "Nov 5, 2024",
    readTime: "5 min read",
    author: "Vlog Expert",
    specs: "1\" Sensor • 4K 120fps • 3-Axis Gimbal",
    price: "$519"
  },
  {
    title: "Insta360 X3: 360° Innovation",
    excerpt: "Revolutionary 360-degree camera with invisible selfie stick and AI editing.",
    image: "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=800&h=600&fit=crop&q=80",
    date: "Nov 3, 2024",
    readTime: "6 min read",
    author: "360 Specialist",
    specs: "72MP 360° • 5.7K Video • FlowState Stabilization",
    price: "$449"
  },
];
---

<Layout title="Cameras - InfoProds" description="Compare the best cameras for photography and videography">
  <main>
    <section class="relative overflow-hidden bg-gradient-to-r from-slate-900/50 to-gray-900/50 py-8">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-12 items-center gap-0">
          
          <div class="col-span-5 relative h-64 ml-6">
            <div class="absolute inset-0 bg-white transform -skew-x-12 origin-left shadow-2xl overflow-hidden">
              <div id="carousel" class="relative h-full w-full">
                {featuredImages.map((image, index) => (
                  <div 
                    class={`carousel-slide absolute inset-0 transition-opacity duration-700 ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
                  >
                    <img 
                      src={image} 
                      alt="Featured Camera"
                      class="w-full h-full object-cover transform scale-110"
                    />
                  </div>
                ))}
              </div>

              <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 z-20">
                {featuredImages.map((_, index) => (
                  <button 
                    class={`carousel-indicator w-2 h-2 rounded-full transition-all ${index === 0 ? 'bg-white w-8' : 'bg-white/50'}`}
                    data-index={index}
                  />
                ))}
              </div>
            </div>
          </div>

          <div class="col-span-7 pl-12">
            <h1 class="text-5xl font-bold mb-3">Cameras</h1>
            <p class="text-lg text-gray-300">Professional cameras for photography and videography</p>
          </div>

        </div>
      </div>
    </section>

    <section class="py-2 -mt-4">
      <div class="container mx-auto px-4">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-4xl font-bold mb-1">Latest Cameras</h2>
            <p class="text-gray-400 text-sm">Expert camera reviews and buying guides</p>
          </div>
          <div class="flex gap-3">
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">Filter</button>
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">Sort</button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {cameras.map((camera) => (
            <article class="group bg-white/5 rounded-2xl overflow-hidden border border-white/10 hover:border-gray-500/50 transition-all hover:scale-105">
              <div class="relative h-40 overflow-hidden">
                <img 
                  src={camera.image} 
                  alt={camera.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 bg-gray-600 rounded-full text-xs font-semibold">Cameras</span>
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-2 text-sm text-gray-400 mb-3">
                  <span>{camera.date}</span>
                  <span>•</span>
                  <span>{camera.readTime}</span>
                </div>

                <h3 class="text-xl font-bold mb-3 group-hover:text-gray-300 transition line-clamp-2">
                  {camera.title}
                </h3>
                
                <p class="text-gray-300 text-sm mb-3 line-clamp-2">
                  {camera.excerpt}
                </p>

                <div class="text-xs text-gray-400 mb-3">
                  {camera.specs}
                </div>

                <div class="flex items-center justify-between pt-3 border-t border-white/10">
                  <span class="text-xl font-bold text-green-400">{camera.price}</span>
                  <a href="#" class="text-gray-400 hover:text-gray-300 text-sm font-semibold">View Deals →</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center mt-12">
          <a href="/devices" class="inline-flex items-center gap-2 px-8 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            <span>←</span>
            <span>Back to All Devices</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.carousel-slide');
    const indicators = document.querySelectorAll('.carousel-indicator');
    const totalSlides = slides.length;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('opacity-100', i === index);
        slide.classList.toggle('opacity-0', i !== index);
      });

      indicators.forEach((indicator, i) => {
        if (i === index) {
          indicator.classList.add('bg-white', 'w-8');
          indicator.classList.remove('bg-white/50', 'w-2');
        } else {
          indicator.classList.remove('bg-white', 'w-8');
          indicator.classList.add('bg-white/50', 'w-2');
        }
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      showSlide(currentSlide);
    }

    setInterval(nextSlide, 4000);

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentSlide = index;
        showSlide(currentSlide);
      });
    });
  </script>
</Layout>