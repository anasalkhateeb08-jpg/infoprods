    excerpt: "Microsoft's most powerful console with Game Pass and backward compatibility.",
    image: "https://images.unsplash.com/photo-1621259182978-fbf93132d53d?w=800&h=600&fit=crop&q=80",
    date: "Nov 18, 2024",
    readTime: "6 min read",
    author: "Xbox Specialist",
    specs: "AMD Zen 2 • 16GB GDDR6 • 4K 120fps • 1TB SSD",
    price: "$499"
  },
  {
    title: "Nintendo Switch OLED: Portable Gaming King",
    excerpt: "Enhanced OLED display and versatile gaming anywhere you go.",
    image: "https://images.unsplash.com/photo-1578303512597-81e6cc155b3e?w=800&h=600&fit=crop&q=80",
    date: "Nov 15, 2024",
    readTime: "5 min read",
    author: "Nintendo Fan",
    specs: "Custom NVIDIA • 4GB RAM • 7\" OLED • 64GB Storage",
    price: "$349"
  },
  {
    title: "Steam Deck: PC Gaming Portable",
    excerpt: "Play your Steam library on the go with this powerful handheld gaming PC.",
    image: "https://images.unsplash.com/photo-1622297845775-5ff3fef71d13?w=800&h=600&fit=crop&q=80",
    date: "Nov 12, 2024",
    readTime: "8 min read",
    author: "PC Gamer",
    specs: "AMD APU • 16GB RAM • 7\" LCD 800p • 512GB SSD",
    price: "$649"
  },
  {
    title: "Xbox Series S: Budget Gaming Powerhouse",
    excerpt: "Compact console with impressive performance at an affordable price.",
    image: "https://images.unsplash.com/photo-1486401899868-0e435ed85128?w=800&h=600&fit=crop&q=80",
    date: "Nov 10, 2024",
    readTime: "5 min read",
