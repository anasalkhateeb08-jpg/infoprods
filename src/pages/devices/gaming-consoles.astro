    excerpt: "Full Windows experience in a portable gaming device with Ryzen power.",
    image: "https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?w=800&h=600&fit=crop&q=80",
    date: "Nov 8, 2024",
    readTime: "6 min read",
    author: "Handheld Pro",
    specs: "Ryzen Z1 Extreme • 16GB RAM • 7\" FHD 120Hz • 512GB",
    price: "$699"
  },
  {
    title: "PlayStation 5 Digital: All-Digital Gaming",
    excerpt: "Same power as PS5 without disc drive for a lower price point.",
    image: "https://images.unsplash.com/photo-1606144042614-b2417e99c4e3?w=800&h=600&fit=crop&q=80",
    date: "Nov 5, 2024",
