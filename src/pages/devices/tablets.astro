---
import Layout from '../../layouts/Layout.astro';

const featuredImages = [
  "https://images.unsplash.com/photo-1561154464-82e9adf32764?w=800&h=600&fit=crop&q=80",
  "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=800&h=600&fit=crop&q=80",
  "https://images.unsplash.com/photo-1585790050230-5dd28404ccb9?w=800&h=600&fit=crop&q=80",
  "https://images.unsplash.com/photo-1612198188060-c7c2a3b66eae?w=800&h=600&fit=crop&q=80",
];

const tablets = [
  {
    title: "iPad Pro M2: Ultimate Tablet Experience",
    excerpt: "Apple's most powerful tablet with M2 chip and stunning Liquid Retina XDR display.",
    image: "https://images.unsplash.com/photo-1561154464-82e9adf32764?w=800&h=600&fit=crop&q=80",
    date: "Nov 20, 2024",
    readTime: "6 min read",
    author: "Tech Expert",
    specs: "M2 Chip • 8GB RAM • 12.9\" Liquid Retina XDR",
    price: "$1,099"
  },
  {
    title: "Samsung Galaxy Tab S9 Ultra: Android Flagship",
    excerpt: "Massive 14.6-inch display with S Pen and desktop-grade performance.",
    image: "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=800&h=600&fit=crop&q=80",
    date: "Nov 18, 2024",
    readTime: "7 min read",
    author: "Android Pro",
    specs: "Snapdragon 8 Gen 2 • 12GB RAM • 14.6\" AMOLED",
    price: "$1,199"
  },
  {
    title: "Microsoft Surface Pro 9: Laptop Replacement",
    excerpt: "Versatile 2-in-1 tablet with full Windows experience and Intel performance.",
    image: "https://images.unsplash.com/photo-1585790050230-5dd28404ccb9?w=800&h=600&fit=crop&q=80",
    date: "Nov 15, 2024",
    readTime: "6 min read",
    author: "Windows Expert",
    specs: "Intel i7 • 16GB RAM • 13\" PixelSense",
    price: "$999"
  },
  {
    title: "iPad Air: Perfect Balance",
    excerpt: "M1 chip delivers incredible performance at a more accessible price point.",
    image: "https://images.unsplash.com/photo-1612198188060-c7c2a3b66eae?w=800&h=600&fit=crop&q=80",
    date: "Nov 12, 2024",
    readTime: "5 min read",
    author: "Apple Specialist",
    specs: "M1 Chip • 8GB RAM • 10.9\" Liquid Retina",
    price: "$599"
  },
  {
    title: "Samsung Galaxy Tab S9: Premium Android",
    excerpt: "Flagship tablet with stunning AMOLED display and S Pen included.",
    image: "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=800&h=600&fit=crop&q=80",
    date: "Nov 10, 2024",
    readTime: "6 min read",
    author: "Tablet Pro",
    specs: "Snapdragon 8 Gen 2 • 8GB RAM • 11\" AMOLED",
    price: "$799"
  },
  {
    title: "Lenovo Tab P12 Pro: Entertainment Beast",
    excerpt: "Massive display with JBL speakers perfect for media consumption.",
    image: "https://images.unsplash.com/photo-1585790050230-5dd28404ccb9?w=800&h=600&fit=crop&q=80",
    date: "Nov 8, 2024",
    readTime: "5 min read",
    author: "Media Expert",
    specs: "Snapdragon 870 • 8GB RAM • 12.6\" AMOLED",
    price: "$699"
  },
  {
    title: "Amazon Fire Max 11: Budget Champion",
    excerpt: "Affordable tablet with great performance for everyday tasks and entertainment.",
    image: "https://images.unsplash.com/photo-1561154464-82e9adf32764?w=800&h=600&fit=crop&q=80",
    date: "Nov 5, 2024",
    readTime: "4 min read",
    author: "Budget Tech",
    specs: "Octa-core • 4GB RAM • 11\" Display",
    price: "$229"
  },
  {
    title: "Xiaomi Pad 6 Pro: Value Flagship",
    excerpt: "Premium features at competitive pricing with excellent display quality.",
    image: "https://images.unsplash.com/photo-1612198188060-c7c2a3b66eae?w=800&h=600&fit=crop&q=80",
