---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const deviceReviews = await getCollection('device-reviews');
  
  // استخراج الفئات الفريدة من deviceCategory
  const categories = [...new Set(deviceReviews.map(review => review.data.deviceCategory))];
  
  return categories.map(category => ({
    params: { device: category.toLowerCase().replace(/\s+/g, '-') },
    props: {
      category,
      reviews: deviceReviews.filter(review => review.data.deviceCategory === category)
    }
  }));
}

const { category, reviews } = Astro.props;
const sortedReviews = reviews.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<Layout 
  title={`${category} - InfoProds`}
  description={`Explore detailed reviews of the latest ${category.toLowerCase()}`}
>
  <section class="bg-gradient-to-br from-purple-600 via-blue-600 to-indigo-700 text-white py-20">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4">📱 {category}</h1>
      <p class="text-xl text-gray-200">Expert reviews and detailed analysis</p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16 bg-gray-900 min-h-screen">
    {sortedReviews.length === 0 ? (
      <div class="text-center py-20">
        <p class="text-xl text-gray-400">No reviews yet. Check back soon!</p>
      </div>
    ) : (
      <>
        <h2 class="text-3xl font-bold mb-8 text-white">Latest Reviews</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedReviews.map((review) => (
            <article class="bg-gray-800 rounded-lg overflow-hidden hover:shadow-xl transition-all duration-300 border border-gray-700">
              {review.data.featuredImage && (
                <img 
                  src={review.data.featuredImage} 
                  alt={review.data.title}
                  class="w-full h-48 object-cover"
                />
              )}
              <div class="p-6">
                <span class="text-xs text-purple-400 font-semibold uppercase tracking-wide">
                  {review.data.deviceCategory}
                </span>
                <h3 class="text-xl font-bold mt-2 mb-3 text-white hover:text-purple-400 transition-colors">
                  <a href={`/device-reviews/${review.data.slug}`}>
                    {review.data.title}
                  </a>
                </h3>
                <p class="text-gray-300 text-sm mb-4 line-clamp-2">
                  {review.data.metaDescription}
                </p>
                <div class="flex items-center text-sm text-gray-400">
                  <span>{review.data.author}</span>
                  <span class="mx-2">•</span>
                  <time datetime={review.data.date}>
                    {new Date(review.data.date).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })}
                  </time>
                </div>
              </div>
            </article>
          ))}
        </div>
      </>
    )}
  </section>
</Layout>