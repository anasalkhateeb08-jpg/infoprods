---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - InfoProds" description="Learn more about InfoProds and our mission to provide the best product information and shopping recommendations.">
  <main>
    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-r from-purple-900/50 to-blue-900/50">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-4">
          About InfoProds
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Your trusted source for product information and smart shopping
        </p>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-4xl font-bold mb-4">Our Mission</h2>
            <p class="text-xl text-gray-300">
              Empowering consumers with comprehensive product information and unbiased recommendations
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
            <div class="text-center p-6 bg-white/5 rounded-2xl border border-white/10">
              <div class="text-5xl mb-4">🎯</div>
              <h3 class="text-xl font-bold mb-2">Quality Information</h3>
              <p class="text-gray-300 text-sm">
                Detailed specs, reviews, and comparisons to help you make informed decisions
              </p>
            </div>

            <div class="text-center p-6 bg-white/5 rounded-2xl border border-white/10">
              <div class="text-5xl mb-4">🤝</div>
              <h3 class="text-xl font-bold mb-2">Trusted Partnerships</h3>
              <p class="text-gray-300 text-sm">
                We partner with reputable retailers to bring you the best deals
              </p>
            </div>

            <div class="text-center p-6 bg-white/5 rounded-2xl border border-white/10">
              <div class="text-5xl mb-4">🚀</div>
              <h3 class="text-xl font-bold mb-2">AI-Powered</h3>
              <p class="text-gray-300 text-sm">
                Advanced technology to provide personalized recommendations
              </p>
            </div>
          </div>

          <div class="prose prose-invert max-w-none">
            <h2 class="text-3xl font-bold mb-6">What We Do</h2>
            <p class="text-gray-300 text-lg mb-4">
              InfoProds is your ultimate destination for product information, reviews, and shopping recommendations. 
              We cover a wide range of categories including fashion, technology, home decor, beauty, and more.
            </p>
            <p class="text-gray-300 text-lg mb-4">
              Our platform combines comprehensive product databases with AI-powered recommendations to help you 
              find exactly what you're looking for. Whether you're shopping for the latest smartphone, updating 
              your wardrobe, or decorating your home, we've got you covered.
            </p>

            <h2 class="text-3xl font-bold mb-6 mt-12">Why Choose Us</h2>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <span class="text-purple-400 text-2xl">✓</span>
                <div>
                  <h3 class="text-xl font-bold mb-2">Comprehensive Coverage</h3>
                  <p class="text-gray-300">8+ categories with thousands of products across multiple niches</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="text-purple-400 text-2xl">✓</span>
                <div>
                  <h3 class="text-xl font-bold mb-2">DeviceSpecs Database</h3>
                  <p class="text-gray-300">Detailed specifications for smartphones, laptops, tablets, cameras, and smartwatches</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="text-purple-400 text-2xl">✓</span>
                <div>
                  <h3 class="text-xl font-bold mb-2">Trusted Partners</h3>
                  <p class="text-gray-300">Direct links to reputable retailers like AliExpress, Banggood, Temu, and Shein</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="text-purple-400 text-2xl">✓</span>
                <div>
                  <h3 class="text-xl font-bold mb-2">Regular Updates</h3>
                  <p class="text-gray-300">Fresh content, latest trends, and new product recommendations every week</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-r from-purple-900/30 to-blue-900/30">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Start Shopping?</h2>
        <p class="text-gray-300 mb-6 max-w-xl mx-auto">
          Explore our categories and discover amazing products at great prices
        </p>
        <div class="flex justify-center gap-4">
          <a href="/" class="px-8 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-semibold transition">
            Explore Categories
          </a>
          <a href="/blog" class="px-8 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Read Our Blog
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>