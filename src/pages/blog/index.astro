---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// قراءة المجلدين
const blogPosts = await getCollection('blog');
const deviceReviews = await getCollection('device-reviews');

// دمج المقالات من المجلدين
const allPosts = [
  ...blogPosts.map(post => ({
    ...post,
    url: `/blog/${post.slug}`,
    image: post.data.image,
    category: post.data.category,
    description: post.data.description
  })),
  ...deviceReviews.map(post => ({
    ...post,
    url: `/device-reviews/${post.data.slug}`,
    image: post.data.featuredImage,
    category: post.data.deviceCategory,
    description: post.data.metaDescription
  }))
];

// ترتيب حسب التاريخ
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = a.data.date instanceof Date ? a.data.date : new Date(a.data.date);
  const dateB = b.data.date instanceof Date ? b.data.date : new Date(b.data.date);
  return dateB.valueOf() - dateA.valueOf();
});
---

<Layout 
  title="Blog - InfoProds" 
  description="Read the latest articles about products, tech reviews, fashion, and lifestyle tips"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-purple-600 via-blue-600 to-indigo-700 text-white py-20">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4">InfoProds Blog</h1>
      <p class="text-xl text-gray-200">Your source for product reviews, tech insights, and lifestyle guides</p>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16 bg-gray-50 min-h-screen">
    {sortedPosts.length === 0 ? (
      <div class="text-center py-20">
        <p class="text-xl text-gray-600">No blog posts yet. Check back soon!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <article class="bg-white rounded-lg overflow-hidden hover:shadow-xl transition-all duration-300 border border-gray-200">
            {post.image && (
              <img 
                src={post.image} 
                alt={post.data.title}
                class="w-full h-48 object-cover"
              />
            )}
            <div class="p-6">
              <span class="text-xs text-purple-600 font-semibold uppercase tracking-wide">
                {post.category}
              </span>
              <h2 class="text-xl font-bold mt-2 mb-3 text-gray-900 hover:text-purple-600 transition-colors">
                <a href={post.url}>
                  {post.data.title}
                </a>
              </h2>
              <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                {post.description}
              </p>
              <div class="flex items-center justify-between text-sm text-gray-500">
                <span>{post.data.author}</span>
                <time datetime={post.data.date instanceof Date ? post.data.date.toISOString() : new Date(post.data.date).toISOString()}>
                  {(post.data.date instanceof Date ? post.data.date : new Date(post.data.date)).toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'short', 
                    day: 'numeric' 
                  })}
                </time>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>