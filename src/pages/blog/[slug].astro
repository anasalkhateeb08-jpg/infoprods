---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleSchema from '../../components/Schema/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/Schema/BreadcrumbSchema.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const breadcrumbs = [
  { name: "Home", url: "https://infoprods.com" },
  { name: "Blog", url: "https://infoprods.com/blog" },
  { name: post.data.title }
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
>
  <ArticleSchema
    title={post.data.title}
    description={post.data.description}
    image={post.data.image}
    date={post.data.date}
    author={post.data.author}
    url={Astro.url.href}
    category={post.data.category}
    tags={post.data.tags}
  />
  <BreadcrumbSchema items={breadcrumbs} />

  <article class="max-w-4xl mx-auto px-4 py-16 bg-white min-h-screen">
    <header class="mb-8">
      <span class="text-sm text-purple-600 font-semibold uppercase tracking-wide">
        {post.data.category}
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mt-2 mb-4">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-4 text-gray-600 text-sm">
        <span>{post.data.author}</span>
        <span>•</span>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
      </div>
    </header>

    {post.data.image && (
      <img
        src={post.data.image}
        alt={post.data.title}
        class="w-full h-96 object-cover rounded-lg mb-8 shadow-sm"
      />
    )}

    <div class="prose prose-lg max-w-none mx-auto px-6">
      <Content />
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="mt-12 pt-8 border-t border-gray-200">
        <h3 class="text-sm text-gray-600 uppercase tracking-wide mb-3">Tags</h3>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-full hover:bg-gray-200 transition-colors">
              {tag}
            </span>
          ))}
        </div>
      </div>
    )}

    <div class="mt-12">
      <a
        href="/blog"
        class="inline-flex items-center text-purple-600 hover:text-purple-700 transition-colors font-medium"
      >
        ← Back to Blog
      </a>
    </div>
  </article>
</Layout>

<style is:global>
  /* 🔥 إضافة is:global هي الحل السحري لتطبيق الألوان على محتوى المقال */
  
  .prose {
    color: #374151;
  }

  /* العناوين H2 - بنفسجي غامق كبير */
  .prose h2 {
    color: #6d28d9 !important;
    font-size: 2rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    line-height: 1.3;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid #e9d5ff;
  }

  /* العناوين H3 - بنفسجي فاتح متوسط */
  .prose h3 {
    color: #7c3aed !important;
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  /* الفقرات */
  .prose p {
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: #4b5563;
  }

  /* القوائم النقطية */
  .prose ul {
    list-style-type: disc;
    margin-left: 2rem;
    margin-bottom: 1.5rem;
  }
  .prose li {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
    line-height: 1.8;
    color: #4b5563;
  }

  /* الروابط - أزرق */
  .prose a {
    color: #2563eb !important;
    text-decoration: none;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    transition: all 0.3s ease;
  }
  .prose a:hover {
    color: #1d4ed8 !important;
    border-bottom-color: #2563eb;
  }

  /* Bold */
  .prose strong {
    color: #111827;
    font-weight: 700;
  }
  
  /* الصور */
  .prose img {
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
</style>