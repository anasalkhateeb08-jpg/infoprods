---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Get all blog posts from content collection
const allPosts = await getCollection('blog');

// Sort by date (newest first)
const blogPosts = allPosts.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
).map(post => ({
  title: post.data.title,
  excerpt: post.data.description,
  category: post.data.category,
  image: post.data.image,
  date: new Date(post.data.date).toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'short', 
    day: 'numeric' 
  }),
  slug: post.slug
}));
---

<Layout title="Blog - InfoProds" description="Read the latest articles, guides, and tips about products, technology, fashion, and lifestyle.">
  <main>
    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-r from-purple-900/50 to-blue-900/50">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-4">
          InfoProds Blog
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Your source for product reviews, tech insights, and lifestyle guides
        </p>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        {blogPosts.length === 0 ? (
          <div class="text-center py-16">
            <p class="text-xl text-gray-400">No blog posts yet. Check back soon!</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {blogPosts.map((post) => (
              <article class="group bg-white/5 rounded-2xl overflow-hidden border border-white/10 hover:border-purple-500/50 transition-all hover:scale-105">
                <!-- Image -->
                <div class="relative h-48 overflow-hidden">
                  <img 
                    src={post.image} 
                    alt={post.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  />
                  <div class="absolute top-4 left-4">
                    <span class="px-3 py-1 bg-purple-600 rounded-full text-xs font-semibold uppercase">
                      {post.category}
                    </span>
                  </div>
                </div>

                <!-- Content -->
                <div class="p-6">
                  <p class="text-sm text-gray-400 mb-2">{post.date}</p>
                  <h2 class="text-xl font-bold mb-3 group-hover:text-purple-400 transition">
                    {post.title}
                  </h2>
                  <p class="text-gray-300 text-sm mb-4 line-clamp-2">
                    {post.excerpt}
                  </p>
                  <a 
                    href={`/blog/${post.slug}`}
                    class="inline-flex items-center text-purple-400 hover:text-purple-300 text-sm font-semibold"
                  >
                    Read More →
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-r from-purple-900/30 to-blue-900/30">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Stay Updated</h2>
        <p class="text-gray-300 mb-6 max-w-xl mx-auto">
          Get the latest product recommendations and shopping tips delivered to your inbox
        </p>
        <div class="flex justify-center gap-4">
          <a href="/categories/fashion" class="px-6 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-semibold transition">
            Explore Categories
          </a>
          <a href="/devices" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Browse Devices
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
