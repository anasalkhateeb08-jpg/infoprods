---
import Layout from '../layouts/Layout.astro';

const blogPosts = [
  {
    title: "Top 10 Fashion Trends for 2024",
    excerpt: "Discover the hottest fashion trends that are dominating runways and streets this year.",
    category: "Fashion",
    image: "https://images.unsplash.com/photo-1483985988355-763728e1935b?w=800&q=80",
    date: "Nov 20, 2024",
    slug: "fashion-trends-2024"
  },
  {
    title: "Best Smartphones Under $500",
    excerpt: "Looking for a budget-friendly smartphone? Here are our top picks that won't break the bank.",
    category: "Tech",
    image: "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=800&q=80",
    date: "Nov 18, 2024",
    slug: "best-smartphones-under-500"
  },
  {
    title: "Home Decor Ideas for Small Spaces",
    excerpt: "Transform your small living space into a stylish and functional home with these clever tips.",
    category: "Home",
    image: "https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=800&q=80",
    date: "Nov 15, 2024",
    slug: "home-decor-small-spaces"
  },
  {
    title: "Essential Kitchen Gadgets Every Cook Needs",
    excerpt: "Upgrade your kitchen with these must-have gadgets that make cooking easier and more fun.",
    category: "Kitchen",
    image: "https://images.unsplash.com/photo-1556911220-bff31c812dba?w=800&q=80",
    date: "Nov 12, 2024",
    slug: "essential-kitchen-gadgets"
  },
  {
    title: "Skincare Routine for Beginners",
    excerpt: "Start your skincare journey with this simple and effective routine for healthy, glowing skin.",
    category: "Beauty",
    image: "https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=800&q=80",
    date: "Nov 10, 2024",
    slug: "skincare-routine-beginners"
  },
  {
    title: "Fitness Gadgets That Actually Work",
    excerpt: "Stay motivated and track your progress with these innovative fitness gadgets and wearables.",
    category: "Fitness",
    image: "https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=800&q=80",
    date: "Nov 8, 2024",
    slug: "fitness-gadgets-2024"
  },
  {
    title: "Unique Gift Ideas for Any Occasion",
    excerpt: "Find the perfect gift for your loved ones with our curated list of unique and thoughtful presents.",
    category: "Gifts",
    image: "https://images.unsplash.com/photo-1513885535751-8b9238bd345a?w=800&q=80",
    date: "Nov 5, 2024",
    slug: "unique-gift-ideas"
  },
  {
    title: "Jewelry Trends: What's Hot Right Now",
    excerpt: "Elevate your style with the latest jewelry trends that are making waves in the fashion world.",
    category: "Jewelry",
    image: "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=800&q=80",
    date: "Nov 3, 2024",
    slug: "jewelry-trends-2024"
  },
];
---

<Layout title="Blog - InfoProds" description="Read the latest articles, guides, and tips about products, technology, fashion, and lifestyle.">
  <main>
    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-r from-purple-900/50 to-blue-900/50">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-4">
          InfoProds Blog
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Your source for product reviews, buying guides, and lifestyle tips
        </p>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {blogPosts.map((post) => (
            <article class="group bg-white/5 rounded-2xl overflow-hidden border border-white/10 hover:border-purple-500/50 transition-all hover:scale-105">
              <!-- Image -->
              <div class="relative h-48 overflow-hidden">
                <img 
                  src={post.image} 
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 bg-purple-600 rounded-full text-xs font-semibold">
                    {post.category}
                  </span>
                </div>
              </div>

              <!-- Content -->
              <div class="p-6">
                <p class="text-sm text-gray-400 mb-2">{post.date}</p>
                <h2 class="text-xl font-bold mb-3 group-hover:text-purple-400 transition">
                  {post.title}
                </h2>
                <p class="text-gray-300 text-sm mb-4 line-clamp-2">
                  {post.excerpt}
                </p>
                <a 
                  href={`/blog/${post.slug}`}
                  class="inline-flex items-center text-purple-400 hover:text-purple-300 text-sm font-semibold"
                >
                  Read More →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-r from-purple-900/30 to-blue-900/30">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Stay Updated</h2>
        <p class="text-gray-300 mb-6 max-w-xl mx-auto">
          Get the latest product recommendations and shopping tips delivered to your inbox
        </p>
        <div class="flex justify-center gap-4">
          <a href="/categories/fashion" class="px-6 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-semibold transition">
            Explore Categories
          </a>
          <a href="/devices" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Browse Devices
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>