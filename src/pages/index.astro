            <img src="https://images.unsplash.com/photo-1495446815901-a7297e633e8d?w=600&q=80" alt="Books" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">📚</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.books">Books & Media</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.booksCount">8,000+ Products</p>
