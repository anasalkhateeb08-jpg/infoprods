---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="InfoProds - Your Space for the Right Information and Products" 
  description="Discover comprehensive product reviews, device specifications, and shopping guides across fashion, electronics, beauty, home decor, and more. Your trusted source for informed purchasing decisions."
  keywords="product reviews, device specs, smartphones, laptops, fashion, beauty, home decor, electronics, shopping guide, product comparison"
  type="website"
>
  <main>
    <!-- Hero Section - Smaller Height -->
    <section class="relative h-[60vh] flex items-center justify-center overflow-hidden">
      <!-- Background -->
      <div class="absolute inset-0 bg-gradient-to-br from-purple-900 via-blue-900 to-black">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1920&q=80')] bg-cover bg-center opacity-10"></div>
      </div>
      
      <!-- Content -->
      <div class="relative z-10 container mx-auto px-4 text-center">
        <h1 class="text-5xl md:text-6xl font-black mb-4 text-white" data-i18n="home.welcome">
          Welcome to InfoProds
        </h1>
        <p class="text-lg md:text-xl text-gray-200 mb-6" data-i18n="home.tagline">
          Your space for the right information and products
        </p>
        
        <div class="flex flex-col md:flex-row gap-3 justify-center mb-8">
          <a href="/blog" class="px-6 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-bold text-base transition shadow-lg" data-i18n="home.exploreBlog">
            Explore Blog
          </a>
          <a href="/devices" class="px-6 py-3 bg-cyan-600 hover:bg-cyan-700 rounded-lg font-bold text-base transition shadow-lg" data-i18n="home.browseDevices">
            Browse Devices
          </a>
        </div>

        <!-- Store Links -->
        <div>
          <p class="text-gray-300 text-sm mb-3" data-i18n="home.shopFrom">Shop from Trusted Stores</p>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href="https://aliexpress.com" target="_blank" class="px-4 py-2 bg-red-600 hover:bg-red-700 rounded-lg text-sm font-semibold transition flex items-center gap-2" aria-label="Shop on AliExpress">
              <span>🛒</span>
              <span>AliExpress</span>
            </a>
            <a href="https://banggood.com" target="_blank" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 rounded-lg text-sm font-semibold transition flex items-center gap-2" aria-label="Shop on Banggood">
              <span>🛍️</span>
              <span>Banggood</span>
            </a>
           <a href="https://temu.com" target="_blank" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 rounded-lg text-sm font-semibold transition flex items-center gap-2" aria-label="Shop on Temu">
              <span>🏪</span>
              <span>Temu</span>
            </a>
            <a href="https://shein.com" target="_blank" class="px-4 py-2 bg-black hover:bg-gray-900 rounded-lg text-sm font-semibold transition flex items-center gap-2" aria-label="Shop on Shein">
              <span>👗</span>
              <span>Shein</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Categories Section - Closer to Top -->
    <section class="py-12 bg-gradient-to-b from-black to-gray-900">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-2" data-i18n="home.exploreCategories">
          Explore Categories
        </h2>
        <p class="text-gray-300 text-center mb-8" data-i18n="home.discoverProducts">
          Discover products across multiple categories
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Fashion -->
          <a href="/categories/fashion" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=600&q=80" alt="Fashion" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">👗</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.fashion">Fashion & Clothing</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.fashionCount">5,000+ Products</p>
            </div>
          </a>

          <!-- Jewelry -->
          <a href="/categories/jewelry" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=600&q=80" alt="Jewelry" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">💎</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.jewelry">Jewelry & Accessories</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.jewelryCount">3,000+ Products</p>
            </div>
          </a>

          <!-- Home -->
          <a href="/categories/home" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?w=600&q=80" alt="Home" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">🏠</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.home">Home & Decor</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.homeCount">4,000+ Products</p>
            </div>
          </a>

          <!-- Beauty -->
          <a href="/categories/beauty" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=600&q=80" alt="Beauty" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">💄</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.beauty">Beauty & Skincare</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.beautyCount">3,500+ Products</p>
            </div>
          </a>

          <!-- Kitchen -->
          <a href="/categories/kitchen" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1556911220-bff31c812dba?w=600&q=80" alt="Kitchen" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">🍳</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.kitchen">Kitchen & Cookware</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.kitchenCount">2,500+ Products</p>
            </div>
          </a>

          <!-- Electronics -->
          <a href="/categories/electronics" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1498049794561-7780e7231661?w=600&q=80" alt="Electronics" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">📱</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.electronics">Electronics</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.electronicsCount">6,000+ Products</p>
            </div>
          </a>

          <!-- Sports -->
          <a href="/categories/fitness-&-health" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=600&q=80" alt="Sports" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">⚽</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.fitness">Fitness & Health</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.fitnessCount">2,000+ Products</p>
            </div>
          </a>

          <!-- Technology & Devices -->
          <a href="/categories/technology-&-devices" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=600&q=80" alt="Technology & Devices" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2"></div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.techDevices">Technology & Devices</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.techDevicesCount">1,500+ Products</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    </main>

  <!-- Additional Schema for HomePage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Fashion & Clothing",
        "url": "https://infoprods.com/categories/fashion"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Jewelry & Accessories",
        "url": "https://infoprods.com/categories/jewelry"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Home & Decor",
        "url": "https://infoprods.com/categories/home"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "Beauty & Skincare",
        "url": "https://infoprods.com/categories/beauty"
      },
      {
        "@type": "ListItem",
        "position": 5,
        "name": "Kitchen & Cookware",
        "url": "https://infoprods.com/categories/kitchen"
      },
      {
        "@type": "ListItem",
        "position": 6,
        "name": "Electronics",
        "url": "https://infoprods.com/categories/electronics"
      },
      {
        "@type": "ListItem",
        "position": 7,
        "name": "Fitness & Health",
        "url": "https://infoprods.com/categories/fitness-&-health"
      },
      {
        "@type": "ListItem",
        "position": 8,
        "name": "Technology & Devices",
        "url": "https://infoprods.com/categories/technology-&-devices"
      }
    ]
  })} />

  <script src="/translations.js" is:inline></script>
  <script>
    // Device Images Carousel
    function startDeviceCarousels() {
      const carousels = document.querySelectorAll('.device-carousel');
      carousels.forEach(carousel => {
        const images = carousel.querySelectorAll('.device-img');
        let currentIndex = 0;
        setInterval(() => {
          images[currentIndex].style.opacity = '0';
          currentIndex = (currentIndex + 1) % images.length;
          images[currentIndex].style.opacity = '1';
        }, 3000);
      });
    }

    // Translation
    function translatePage(lang) {
      const elements = document.querySelectorAll('[data-i18n]');
      elements.forEach(element => {
        const key = element.getAttribute('data-i18n');
        const keys = key.split('.');
        let translation = translations[lang];
        for (const k of keys) {
          translation = translation?.[k];
        }
        if (translation) {
          element.textContent = translation;
        }
      });
      localStorage.setItem('selectedLang', lang);
      document.documentElement.lang = lang;
      if (lang === 'ar') {
        document.documentElement.dir = 'rtl';
      } else {
        document.documentElement.dir = 'ltr';
      }
    }
    
    document.addEventListener('DOMContentLoaded', () => {
      const savedLang = localStorage.getItem('selectedLang') || 'en';
      translatePage(savedLang);
      startDeviceCarousels();
    });
    
    window.addEventListener('languageChanged', (e) => {
      translatePage(e.detail.lang);
    });
  </script>
</Layout>





