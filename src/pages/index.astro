        <div class="text-center">
          <a href="/devices" class="inline-block px-8 py-3 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 rounded-lg font-bold text-base transition shadow-lg" data-i18n="home.viewAllDevices">
            View All Devices →
