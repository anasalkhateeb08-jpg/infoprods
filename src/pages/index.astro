        <div class="absolute top-0 left-0 w-full h-96 bg-gradient-to-b from-green-500/20 via-cyan-500/10 to-transparent blur-2xl"></div>
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1920&q=80')] bg-cover bg-center opacity-8"></div>
      </div>`,
      
      // 7. Sunset Vibes
      `<div class="absolute inset-0 bg-gradient-to-br from-orange-900 via-rose-900 to-purple-950">
        <div class="absolute bottom-0 left-0 w-full h-96 bg-gradient-to-t from-amber-600/30 via-red-600/20 to-transparent blur-3xl"></div>
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1920&q=80')] bg-cover bg-center opacity-10"></div>
      </div>`,
      
      // 8. Ocean Depth
      `<div class="absolute inset-0 bg-gradient-to-br from-blue-950 via-cyan-900 to-teal-950">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 30% 20%, rgba(6, 182, 212, 0.2) 0%, transparent 50%), radial-gradient(circle at 70% 80%, rgba(20, 184, 166, 0.15) 0%, transparent 50%);"></div>
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1920&q=80')] bg-cover bg-center opacity-8"></div>
      </div>`
    ];

    function rotateBackground() {
      const bgContainer = document.querySelector('.hero-background');
      if (!bgContainer) return;

      let currentIndex = parseInt(localStorage.getItem('bgIndex') || '0');
      currentIndex = (currentIndex + 1) % backgrounds.length;
      localStorage.setItem('bgIndex', currentIndex.toString());
      bgContainer.innerHTML = backgrounds[currentIndex];
    }

    document.addEventListener('DOMContentLoaded', () => {
      const bgContainer = document.querySelector('.hero-background');
      if (bgContainer) {
        const currentIndex = parseInt(localStorage.getItem('bgIndex') || '0');
        bgContainer.innerHTML = backgrounds[currentIndex];
      }
      
      setInterval(rotateBackground, 600000);
    });
  </script>
</Layout>