---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="InfoProds - Your Space for the Right Information and Products" 
  description="Discover comprehensive product reviews, device specifications, and shopping guides across fashion, electronics, beauty, home decor, and more. Your trusted source for informed purchasing decisions."
  keywords="product reviews, device specs, smartphones, laptops, fashion, beauty, home decor, electronics, shopping guide, product comparison"
  type="website"
>
  <main>
    <!-- Hero Section - Smaller Height -->
    <section class="relative h-[60vh] flex items-center justify-center overflow-hidden">
      <!-- Background -->
      <div class="absolute inset-0 bg-gradient-to-br from-purple-900 via-blue-900 to-black">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1920&q=80')] bg-cover bg-center opacity-10"></div>
      </div>
      
      <!-- Content -->
      <div class="relative z-10 container mx-auto px-4 text-center">
        <h1 class="text-5xl md:text-6xl font-black mb-4 text-white" data-i18n="home.welcome">
          Welcome to InfoProds
        </h1>
        <p class="text-lg md:text-xl text-gray-200 mb-6" data-i18n="home.tagline">
          Your space for the right information and products
        </p>
        
        <div class="flex flex-col md:flex-row gap-3 justify-center mb-8">
          <a href="/blog" class="px-6 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-bold text-base transition shadow-lg" data-i18n="home.exploreBlog">
            Explore Blog
          </a>
          <a href="/devices" class="px-6 py-3 bg-cyan-600 hover:bg-cyan-700 rounded-lg font-bold text-base transition shadow-lg" data-i18n="home.browseDevices">
            Browse Devices
          </a>
        </div>

        <!-- Store Links -->
        <div>
          <p class="text-gray-300 text-sm mb-3" data-i18n="home.shopFrom">Shop from Trusted Stores</p>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href="https://aliexpress.com" target="_blank" class="px-4 py-2 bg-red-600 hover:bg-red-700 rounded-lg text-sm font-semibold transition flex items-center gap-2" aria-label="Shop on AliExpress">
              <span>🛒</span>
              <span>AliExpress</span>
            </a>
            <a href="https://banggood.com" target="_blank" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 rounded-lg text-sm font-semibold transition flex items-center gap-2" aria-label="Shop on Banggood">
              <span>🛍️</span>
              <span>Banggood</span>
            </a>
           <a href="https://temu.com" target="_blank" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 rounded-lg text-sm font-semibold transition flex items-center gap-2" aria-label="Shop on Temu">
              <span>🏪</span>
              <span>Temu</span>
            </a>
            <a href="https://shein.com" target="_blank" class="px-4 py-2 bg-black hover:bg-gray-900 rounded-lg text-sm font-semibold transition flex items-center gap-2" aria-label="Shop on Shein">
              <span>👗</span>
              <span>Shein</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Categories Section - Closer to Top -->
    <section class="py-12 bg-gradient-to-b from-black to-gray-900">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-2" data-i18n="home.exploreCategories">
          Explore Categories
        </h2>
        <p class="text-gray-300 text-center mb-8" data-i18n="home.discoverProducts">
