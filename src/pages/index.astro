  <script src="/translations.js" is:inline></script>
  <script>
    // Device Images Carousel
    function startDeviceCarousels() {
      const carousels = document.querySelectorAll('.device-carousel');
      carousels.forEach(carousel => {
        const images = carousel.querySelectorAll('.device-img');
        let currentIndex = 0;
        setInterval(() => {
          images[currentIndex].style.opacity = '0';
          currentIndex = (currentIndex + 1) % images.length;
          images[currentIndex].style.opacity = '1';
        }, 3000);
      });
    }

    // Translation
    function translatePage(lang) {
      const elements = document.querySelectorAll('[data-i18n]');
      elements.forEach(element => {
        const key = element.getAttribute('data-i18n');
        const keys = key.split('.');
        let translation = translations[lang];
        for (const k of keys) {
          translation = translation?.[k];
        }
        if (translation) {
          element.textContent = translation;
        }
      });
      localStorage.setItem('selectedLang', lang);
      document.documentElement.lang = lang;
      if (lang === 'ar') {
        document.documentElement.dir = 'rtl';
      } else {
        document.documentElement.dir = 'ltr';
      }
    }
    
    document.addEventListener('DOMContentLoaded', () => {
      const savedLang = localStorage.getItem('selectedLang') || 'en';
      translatePage(savedLang);
      startDeviceCarousels();
    });
    
    window.addEventListener('languageChanged', (e) => {
      translatePage(e.detail.lang);
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const categories = document.querySelectorAll('[data-category]');
      
      for (const card of categories) {
        const category = card.dataset.category;
        const img = card.querySelector('img');
        
        try {
          const response = await fetch(`/api/category-images?category=${encodeURIComponent(category)}`);
          const images = await response.json();
          
          if (images.length > 1) {
            let currentIndex = 0;
            setInterval(() => {
              currentIndex = (currentIndex + 1) % images.length;
              img.src = images[currentIndex];
            }, 2000);
          }
        } catch (error) {
          console.error(`Error loading images for ${category}:`, error);
        }
      }
    });
  </script>
  
  <script>
    function initDiamondCarousels() {
      const leftSlides = document.querySelectorAll('.diamond-left .diamond-slide');
      const rightSlides = document.querySelectorAll('.diamond-right .diamond-slide');

      if (leftSlides.length === 0 || rightSlides.length === 0) return;

      let leftIndex = 0;
      let rightIndex = 0;

      setInterval(() => {
        leftSlides[leftIndex].classList.remove('active');
        leftIndex = (leftIndex + 1) % leftSlides.length;
        leftSlides[leftIndex].classList.add('active');
      }, 3000);

      setTimeout(() => {
        setInterval(() => {
          rightSlides[rightIndex].classList.remove('active');
          rightIndex = (rightIndex + 1) % rightSlides.length;
          rightSlides[rightIndex].classList.add('active');
        }, 3000);
      }, 2000);
    }

    document.addEventListener('DOMContentLoaded', initDiamondCarousels);
  </script>
  
  <style>
    .diamond-left,
    .diamond-right {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 5;
    }

    .diamond-left {
      left: 4rem;
    }

    .diamond-right {
      right: 4rem;
    }

    .diamond-wrapper {
      width: 400px;
      height: 200px;
    }

    .diamond-shape {
      position: relative;
      width: 100%;
      height: 100%;
      transform: skewX(-20deg);
      overflow: hidden;
      border-radius: 15px;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
      border: 3px solid rgba(255, 255, 255, 0.3);
    }

    .diamond-slide {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 1s ease-in-out;
    }

    .diamond-slide.active {
      opacity: 1;
    }

    .diamond-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: skewX(20deg) scale(1.3);
    }

    .diamond-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to bottom, transparent 40%, rgba(0, 0, 0, 0.8) 100%);
      transform: skewX(20deg);
    }

    .diamond-text {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 1.5rem;
      transform: skewX(20deg);
      z-index: 5;
    }

    .diamond-text h3 {
      color: white;
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.4;
      margin: 0;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
    }

    @media (max-width: 1280px) {
      .diamond-left,
      .diamond-right {
        display: none;
      }
    }
    
    /* Affiliate Links Ticker */
    .ticker-section {
      background: black;
      overflow: hidden;
      padding: 1rem 0;
      border-top: 2px solid rgba(139, 92, 246, 0.3);
      border-bottom: 2px solid rgba(139, 92, 246, 0.3);
    }

    .ticker-wrapper {
      width: 100%;
      overflow: hidden;
    }

    .ticker-content {
      display: flex;
      animation: scroll 30s linear infinite;
      gap: 3rem;
    }

    .ticker-content:hover {
      animation-play-state: paused;
    }

    .ticker-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .ticker-text {
      color: #ef4444;
      font-weight: 600;
      font-size: 1rem;
    }

    .ticker-link {
      color: #3b82f6;
      text-decoration: underline;
      font-weight: 700;
      transition: color 0.3s ease;
    }

    .ticker-link:hover {
      color: #60a5fa;
    }

    @keyframes scroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }

    @media (max-width: 768px) {
      .ticker-content {
        animation: scroll 20s linear infinite;
      }
    }
  </style>
  
  <script>
