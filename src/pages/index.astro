        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Fashion -->
          <a href="/categories/fashion" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=600&q=80" alt="Fashion" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">👗</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.fashion">Fashion & Clothing</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.fashionCount">5,000+ Products</p>
            </div>
          </a>

          <!-- Jewelry -->
          <a href="/categories/jewelry" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=600&q=80" alt="Jewelry" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">💎</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.jewelry">Jewelry & Accessories</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.jewelryCount">3,000+ Products</p>
            </div>
          </a>

          <!-- Home -->
          <a href="/categories/home" class="group relative h-64 rounded-2xl overflow-hidden hover:scale-105 transition-transform duration-300">
            <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?w=600&q=80" alt="Home" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="text-4xl mb-2">🏠</div>
              <h3 class="text-xl font-bold mb-1" data-i18n="categories.home">Home & Decor</h3>
              <p class="text-sm text-gray-300" data-i18n="categories.homeCount">4,000+ Products</p>
            </div>
          </a>

          <!-- Beauty -->
