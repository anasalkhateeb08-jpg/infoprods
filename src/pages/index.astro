---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const shuffled = allPosts.sort(() => 0.5 - Math.random());
const leftPosts = [...shuffled];
const rightPosts = [...shuffled].sort(() => 0.5 - Math.random());





---

<Layout 
  title="InfoProds - Your Knowledge Hub for Smart Shopping"
  description="In-depth articles, expert reviews, and comprehensive buying guides for tech, fashion, beauty, and home products. Make informed purchasing decisions."
  keywords="product reviews, buying guides, fashion trends, technology reviews, beauty skincare, home decor, expert reviews, shopping guide, InfoProds, smart shopping"
  type="website"
>
  <main>
    <!-- Hero Section - Smaller Height -->
    <section class="relative h-[50vh] flex items-center justify-center overflow-hidden">
      <!-- Background -->
      <div class="hero-background absolute inset-0"></div>
      
      <!-- Left Diamond Carousel -->
      <div class="diamond-left">
        <div class="diamond-wrapper">
          <div class="diamond-shape">
            {leftPosts.map((post, index) => (
              <a 
                href={`/blog/${post.slug}`}
                class={`diamond-slide${index === 0 ? ' active' : ''}`}
                data-index={index}
              >
                <img 
                  src={post.data.image} 
                  alt={post.data.title}
                  class="diamond-img" 
                />
                <div class="diamond-overlay"></div>
                <div class="diamond-text">
                  <h3>{post.data.title.slice(0, 60)}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Diamond Carousel -->
      <div class="diamond-right">
        <div class="diamond-wrapper">
          <div class="diamond-shape">
            {rightPosts.map((post, index) => (
              <a 
                href={`/blog/${post.slug}`}
                class={`diamond-slide${index === 0 ? ' active' : ''}`}
                data-index={index}
              >
                <img 
                  src={post.data.image} 
                  alt={post.data.title}
                  class="diamond-img" 
                />
                <div class="diamond-overlay"></div>
                <div class="diamond-text">
                  <h3>{post.data.title.slice(0, 60)}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Content -->
      <div class="relative z-10 container mx-auto px-4 text-center">
        <h1 class="text-5xl md:text-6xl font-black mb-2 text-white">
          InfoProds
        </h1>
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white opacity-95">
          Your Knowledge Hub
        </h2>
        <p class="text-xl md:text-2xl font-semibold text-gray-200 mb-6 max-w-4xl mx-auto">
          In-depth articles, guides, and expert reviews<br>to help you make informed purchasing decisions
        </p>   
        <div class="flex flex-col md:flex-row gap-3 justify-center">
          <a href="/blog" class="px-6 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-bold text-base transition shadow-lg" data-i18n="home.exploreBlog">
            Explore Blog
          </a>
          <a href="/blog" class="px-6 py-3 bg-transparent border-2 border-white hover:bg-white hover:text-purple-600 rounded-lg font-bold text-base transition shadow-lg">
            Latest Reviews
          </a>
        </div>
      </div>
    </section>



