---
import Layout from '../../layouts/Layout.astro';

const featuredImages = [
  "https://images.unsplash.com/photo-1483985988355-763728e1935b?w=800&q=80",
  "https://images.unsplash.com/photo-1445205170230-053b83016050?w=800&q=80",
  "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=800&q=80",
  "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=800&q=80",
];

const articles = [
  {
    title: "10 Fashion Trends That Will Dominate 2024",
    excerpt: "From Y2K revival to sustainable fashion, discover the styles that are shaping the future of fashion this year.",
    image: "https://images.unsplash.com/photo-1483985988355-763728e1935b?w=800&q=80",
    date: "Nov 20, 2024",
    readTime: "5 min read",
    author: "Fashion Editor",
    slug: "fashion-trends-2024"
  },
  {
    title: "How to Build a Capsule Wardrobe on a Budget",
    excerpt: "Learn the art of creating a versatile wardrobe with fewer pieces that work perfectly together.",
    image: "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=800&q=80",
    date: "Nov 18, 2024",
    readTime: "7 min read",
    author: "Style Guide",
    slug: "capsule-wardrobe-budget"
  },
  {
    title: "Sustainable Fashion: A Complete Guide",
    excerpt: "Everything you need to know about ethical fashion, eco-friendly brands, and making conscious choices.",
    image: "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=800&q=80",
    date: "Nov 15, 2024",
    readTime: "8 min read",
    author: "Eco Fashion",
    slug: "sustainable-fashion-guide"
  },
  {
    title: "Dressing for Your Body Type: The Ultimate Guide",
    excerpt: "Discover how to choose clothes that flatter your unique body shape and boost your confidence.",
    image: "https://images.unsplash.com/photo-1558769132-cb1aea1f1d8a?w=800&q=80",
    date: "Nov 12, 2024",
    readTime: "6 min read",
    author: "Style Expert",
    slug: "body-type-guide"
  },
  {
    title: "Seasonal Color Analysis: Find Your Perfect Palette",
    excerpt: "Learn which colors complement your skin tone and how to build a wardrobe around them.",
    image: "https://images.unsplash.com/photo-1445205170230-053b83016050?w=800&q=80",
    date: "Nov 10, 2024",
    readTime: "5 min read",
    author: "Color Expert",
    slug: "seasonal-color-analysis"
  },
  {
    title: "Men's Fashion Essentials: 20 Must-Have Items",
    excerpt: "Build a solid foundation for your wardrobe with these timeless pieces every man should own.",
    image: "https://images.unsplash.com/photo-1490578474895-699cd4e2cf59?w=800&q=80",
    date: "Nov 8, 2024",
    readTime: "6 min read",
    author: "Men's Style",
    slug: "mens-fashion-essentials"
  },
  {
    title: "Vintage Fashion: How to Shop and Style Retro Pieces",
    excerpt: "A comprehensive guide to finding, authenticating, and incorporating vintage fashion into your modern wardrobe.",
    image: "https://images.unsplash.com/photo-1492707892479-7bc8d5a4ee93?w=800&q=80",
    date: "Nov 5, 2024",
    readTime: "7 min read",
    author: "Vintage Expert",
    slug: "vintage-fashion-guide"
  },
  {
    title: "Accessorizing 101: Elevate Your Outfits",
    excerpt: "Master the art of accessories and learn how small details can transform your entire look.",
    image: "https://images.unsplash.com/photo-1509319117737-5f2f1d3e4e89?w=800&q=80",
    date: "Nov 3, 2024",
    readTime: "5 min read",
    author: "Accessories Pro",
    slug: "accessorizing-guide"
  },
];
---

<Layout title="Fashion & Clothing Articles - InfoProds" description="Read the latest fashion trends, styling tips, and clothing guides.">
  <main>
    <!-- Hero with Diagonal Image Carousel -->
    <section class="relative overflow-hidden bg-gradient-to-r from-pink-900/50 to-rose-900/50 py-8">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-12 items-center gap-0">
          
          <!-- Left: Diagonal White Image Carousel -->
          <div class="col-span-5 relative h-64 ml-6">
            <!-- White Diagonal Shape with Images Inside -->
            <div class="absolute inset-0 bg-white transform -skew-x-12 origin-left shadow-2xl overflow-hidden">
              <!-- Carousel Images - Fill entire diagonal shape -->
              <div id="carousel" class="relative h-full w-full">
                {featuredImages.map((image, index) => (
                  <div 
                    class={`carousel-slide absolute inset-0 transition-opacity duration-700 ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
                  >
                    <img 
                      src={image} 
                      alt="Featured Article"
                      class="w-full h-full object-cover transform scale-110"
                    />
                  </div>
                ))}
              </div>

              <!-- Indicators -->
              <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 z-20">
                {featuredImages.map((_, index) => (
                  <button 
                    class={`carousel-indicator w-2 h-2 rounded-full transition-all ${index === 0 ? 'bg-white w-8' : 'bg-white/50'}`}
                    data-index={index}
                  />
                ))}
              </div>
            </div>
          </div>

          <!-- Right: Text -->
          <div class="col-span-7 pl-12">
            <h1 class="text-5xl font-bold mb-3">
              Fashion & Clothing
            </h1>
            <p class="text-lg text-gray-300">
              Your complete guide to fashion trends, styling tips, and wardrobe essentials
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- Articles Grid -->
    <section class="py-2 -mt-4">
      <div class="container mx-auto px-4">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-4xl font-bold mb-1">Latest Articles</h2>
            <p class="text-gray-400 text-sm">Expert fashion advice and trend analysis</p>
          </div>
          <div class="flex gap-3">
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">
              Filter
            </button>
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">
              Sort
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {articles.map((article) => (
            <article class="group bg-white/5 rounded-2xl overflow-hidden border border-white/10 hover:border-pink-500/50 transition-all hover:scale-105">
              <div class="relative h-40 overflow-hidden">
                <img 
                  src={article.image} 
                  alt={article.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 bg-pink-600 rounded-full text-xs font-semibold">
                    Fashion
                  </span>
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-2 text-sm text-gray-400 mb-3">
                  <span>{article.date}</span>
                  <span>•</span>
                  <span>{article.readTime}</span>
                </div>

                <h3 class="text-xl font-bold mb-3 group-hover:text-pink-400 transition line-clamp-2">
                  {article.title}
                </h3>
                
                <p class="text-gray-300 text-sm mb-4 line-clamp-2">
                  {article.excerpt}
                </p>

                <div class="flex items-center justify-between">
                  <span class="text-xs text-gray-500">{article.author}</span>
                  <a 
                    href={`/blog/${article.slug}`}
                    class="text-pink-400 hover:text-pink-300 text-sm font-semibold"
                  >
                    Read More →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center mt-12">
          <button class="px-8 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Load More Articles
          </button>
        </div>
      </div>
    </section>

    <!-- Featured Guides -->
    <section class="py-16 bg-black/20">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Popular Fashion Guides</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-pink-500/10 to-rose-500/10 rounded-2xl p-6 border border-pink-500/20">
            <div class="text-4xl mb-4">📚</div>
            <h3 class="text-xl font-bold mb-2">Style Fundamentals</h3>
            <p class="text-gray-300 text-sm mb-4">Learn the basics of fashion and develop your personal style</p>
            <a href="#" class="text-pink-400 hover:text-pink-300 text-sm font-semibold">
              Explore →
            </a>
          </div>

          <div class="bg-gradient-to-br from-rose-500/10 to-pink-500/10 rounded-2xl p-6 border border-rose-500/20">
            <div class="text-4xl mb-4">🛍️</div>
            <h3 class="text-xl font-bold mb-2">Shopping Guides</h3>
            <p class="text-gray-300 text-sm mb-4">Smart shopping tips and how to find quality pieces</p>
            <a href="#" class="text-rose-400 hover:text-rose-300 text-sm font-semibold">
              Explore →
            </a>
          </div>

          <div class="bg-gradient-to-br from-fuchsia-500/10 to-rose-500/10 rounded-2xl p-6 border border-fuchsia-500/20">
            <div class="text-4xl mb-4">✨</div>
            <h3 class="text-xl font-bold mb-2">Trend Reports</h3>
            <p class="text-gray-300 text-sm mb-4">Stay updated with the latest fashion trends and forecasts</p>
            <a href="#" class="text-fuchsia-400 hover:text-fuchsia-300 text-sm font-semibold">
              Explore →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-r from-pink-900/30 to-rose-900/30">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Explore More Categories</h2>
        <p class="text-gray-300 mb-6">Discover articles about jewelry, beauty, home decor, and more</p>
        <div class="flex justify-center gap-4 flex-wrap">
          <a href="/categories/jewelry" class="px-6 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-semibold transition">
            Jewelry
          </a>
          <a href="/categories/beauty" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Beauty
          </a>
          <a href="/categories/home" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Home Decor
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Carousel Script -->
  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.carousel-slide');
    const indicators = document.querySelectorAll('.carousel-indicator');
    const totalSlides = slides.length;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('opacity-100', i === index);
        slide.classList.toggle('opacity-0', i !== index);
      });

      indicators.forEach((indicator, i) => {
        if (i === index) {
          indicator.classList.add('bg-white', 'w-8');
          indicator.classList.remove('bg-white/50', 'w-2');
        } else {
          indicator.classList.remove('bg-white', 'w-8');
          indicator.classList.add('bg-white/50', 'w-2');
        }
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      showSlide(currentSlide);
    }

    setInterval(nextSlide, 4000);

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentSlide = index;
        showSlide(currentSlide);
      });
    });
  </script>
</Layout>