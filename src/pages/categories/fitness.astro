---
import Layout from '../../layouts/Layout.astro';

const featuredImages = [
  "https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=800&q=80",
  "https://images.unsplash.com/photo-1575311373937-040b8e1fd5b6?w=800&q=80",
  "https://images.unsplash.com/photo-1598971639058-fab3c3109a00?w=800&q=80",
  "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&q=80",
];

const allArticles = [
  {
    title: "Home Gym Essentials: Build Your Perfect Workout Space",
    excerpt: "Create an effective home gym with these must-have equipment pieces and smart layouts.",
    image: "https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=800&q=80",
    date: "Nov 21, 2024",
    readTime: "9 min read",
    author: "Fitness Coach",
    slug: "home-gym-essentials"
  },
  {
    title: "Fitness Trackers vs Smartwatches: Which Is Right for You?",
    excerpt: "Compare features, benefits, and prices to find the perfect wearable for your fitness goals.",
    image: "https://images.unsplash.com/photo-1575311373937-040b8e1fd5b6?w=800&q=80",
    date: "Nov 19, 2024",
    readTime: "7 min read",
    author: "Wearable Tech",
    slug: "fitness-trackers-guide"
  },
  {
    title: "Resistance Bands Workout: Full Body Routine",
    excerpt: "Get fit anywhere with these effective resistance band exercises for all fitness levels.",
    image: "https://images.unsplash.com/photo-1598971639058-fab3c3109a00?w=800&q=80",
    date: "Nov 17, 2024",
    readTime: "6 min read",
    author: "Trainer",
    slug: "resistance-bands-workout"
  },
  {
    title: "Running Shoes Buying Guide 2024",
    excerpt: "Find the perfect running shoes based on your gait, distance, and terrain preferences.",
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=800&q=80",
    date: "Nov 15, 2024",
    readTime: "8 min read",
    author: "Running Expert",
    slug: "running-shoes-guide"
  },
  {
    title: "Yoga Equipment for Beginners: What You Really Need",
    excerpt: "Start your yoga journey right with these essential mats, props, and accessories.",
    image: "https://images.unsplash.com/photo-1588286840104-8957b019727f?w=800&q=80",
    date: "Nov 13, 2024",
    readTime: "5 min read",
    author: "Yoga Instructor",
    slug: "yoga-equipment-beginners"
  },
  {
    title: "Hydration Essentials: Best Water Bottles for Athletes",
    excerpt: "Stay hydrated during workouts with these durable, functional water bottle options.",
    image: "https://images.unsplash.com/photo-1523362628745-0c100150b504?w=800&q=80",
    date: "Nov 11, 2024",
    readTime: "5 min read",
    author: "Hydration",
    slug: "best-water-bottles"
  },
  {
    title: "Foam Rolling: Benefits and Best Practices",
    excerpt: "Learn how to use foam rollers effectively for recovery and injury prevention.",
    image: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&q=80",
    date: "Nov 9, 2024",
    readTime: "6 min read",
    author: "Recovery Pro",
    slug: "foam-rolling-guide"
  },
  {
    title: "Workout Clothes: Performance Fabrics Explained",
    excerpt: "Understand moisture-wicking, compression, and other fabric technologies for optimal comfort.",
    image: "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&q=80",
    date: "Nov 7, 2024",
    readTime: "6 min read",
    author: "Athletic Wear",
    slug: "workout-clothes-guide"
  },
];
---

<Layout title="Fitness & Sports Articles - InfoProds" description="Fitness gear reviews, workout tips, and sports equipment guides.">
  <main>
    <!-- Hero with Diagonal Image Carousel -->
    <section class="relative overflow-hidden bg-gradient-to-r from-orange-900/50 to-red-900/50 py-8">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-12 items-center gap-0">
          
          <!-- Left: Diagonal White Image Carousel -->
          <div class="col-span-5 relative h-64 ml-6">
            <!-- White Diagonal Shape with Images Inside -->
            <div class="absolute inset-0 bg-white transform -skew-x-12 origin-left shadow-2xl overflow-hidden">
              <!-- Carousel Images - Fill entire diagonal shape -->
              <div id="carousel" class="relative h-full w-full">
                {featuredImages.map((image, index) => (
                  <div 
                    class={`carousel-slide absolute inset-0 transition-opacity duration-700 ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
                  >
                    <img 
                      src={image} 
                      alt="Featured Article"
                      class="w-full h-full object-cover transform scale-110"
                    />
                  </div>
                ))}
              </div>

              <!-- Indicators -->
              <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 z-20">
                {featuredImages.map((_, index) => (
                  <button 
                    class={`carousel-indicator w-2 h-2 rounded-full transition-all ${index === 0 ? 'bg-white w-8' : 'bg-white/50'}`}
                    data-index={index}
                  />
                ))}
              </div>
            </div>
          </div>

          <!-- Right: Text -->
          <div class="col-span-7 pl-12">
            <h1 class="text-5xl font-bold mb-3">
              Fitness & Sports
            </h1>
            <p class="text-lg text-gray-300">
              Achieve your fitness goals with the right gear, guidance, and motivation
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- Articles Grid -->
    <section class="py-2 -mt-4">
      <div class="container mx-auto px-4">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-4xl font-bold mb-1">Latest Articles</h2>
            <p class="text-gray-400 text-sm">Expert fitness advice and equipment reviews</p>
          </div>
          <div class="flex gap-3">
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">
              Filter
            </button>
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">
              Sort
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {allArticles.map((article) => (
            <article class="group bg-white/5 rounded-2xl overflow-hidden border border-white/10 hover:border-orange-500/50 transition-all hover:scale-105">
              <div class="relative h-35 overflow-hidden">
                <img 
                  src={article.image} 
                  alt={article.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 bg-orange-600 rounded-full text-xs font-semibold">
                    Fitness
                  </span>
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-2 text-sm text-gray-400 mb-3">
                  <span>{article.date}</span>
                  <span>•</span>
                  <span>{article.readTime}</span>
                </div>

                <h3 class="text-xl font-bold mb-3 group-hover:text-orange-400 transition line-clamp-2">
                  {article.title}
                </h3>
                
                <p class="text-gray-300 text-sm mb-4 line-clamp-2">
                  {article.excerpt}
                </p>

                <div class="flex items-center justify-between">
                  <span class="text-xs text-gray-500">{article.author}</span>
                  <a 
                    href={`/blog/${article.slug}`}
                    class="text-orange-400 hover:text-orange-300 text-sm font-semibold"
                  >
                    Read More →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center mt-12">
          <button class="px-8 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Load More Articles
          </button>
        </div>
      </div>
    </section>

    <!-- Featured Guides -->
    <section class="py-16 bg-black/20">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Popular Fitness Guides</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-orange-500/10 to-red-500/10 rounded-2xl p-6 border border-orange-500/20">
            <div class="text-4xl mb-4">🏋️</div>
            <h3 class="text-xl font-bold mb-2">Strength Training</h3>
            <p class="text-gray-300 text-sm mb-4">Build muscle with weights and resistance</p>
            <a href="#" class="text-orange-400 hover:text-orange-300 text-sm font-semibold">
              Explore →
            </a>
          </div>

          <div class="bg-gradient-to-br from-red-500/10 to-pink-500/10 rounded-2xl p-6 border border-red-500/20">
            <div class="text-4xl mb-4">🏃</div>
            <h3 class="text-xl font-bold mb-2">Cardio & Running</h3>
            <p class="text-gray-300 text-sm mb-4">Improve endurance and burn calories</p>
            <a href="#" class="text-red-400 hover:text-red-300 text-sm font-semibold">
              Explore →
            </a>
          </div>

          <div class="bg-gradient-to-br from-pink-500/10 to-orange-500/10 rounded-2xl p-6 border border-pink-500/20">
            <div class="text-4xl mb-4">🧘</div>
            <h3 class="text-xl font-bold mb-2">Flexibility & Recovery</h3>
            <p class="text-gray-300 text-sm mb-4">Yoga, stretching, and injury prevention</p>
            <a href="#" class="text-pink-400 hover:text-pink-300 text-sm font-semibold">
              Explore →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-r from-orange-900/30 to-red-900/30">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Explore More Categories</h2>
        <p class="text-gray-300 mb-6">Discover articles about beauty, fashion, tech, and more</p>
        <div class="flex justify-center gap-4 flex-wrap">
          <a href="/categories/beauty" class="px-6 py-3 bg-rose-600 hover:bg-rose-700 rounded-lg font-semibold transition">
            Beauty
          </a>
          <a href="/categories/tech-gadgets" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Tech Gadgets
          </a>
          <a href="/categories/fashion" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Fashion
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Carousel Script -->
  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.carousel-slide');
    const indicators = document.querySelectorAll('.carousel-indicator');
    const totalSlides = slides.length;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('opacity-100', i === index);
        slide.classList.toggle('opacity-0', i !== index);
      });

      indicators.forEach((indicator, i) => {
        if (i === index) {
          indicator.classList.add('bg-white', 'w-8');
          indicator.classList.remove('bg-white/50', 'w-2');
        } else {
          indicator.classList.remove('bg-white', 'w-8');
          indicator.classList.add('bg-white/50', 'w-2');
        }
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      showSlide(currentSlide);
    }

    setInterval(nextSlide, 4000);

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentSlide = index;
        showSlide(currentSlide);
      });
    });
  </script>
</Layout>