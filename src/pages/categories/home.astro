---
import Layout from '../../layouts/Layout.astro';

const featuredImages = [
  "https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=800&q=80",
  "https://images.unsplash.com/photo-1556912167-f556f1f39faa?w=800&q=80",
  "https://images.unsplash.com/photo-1615873968403-89e068629265?w=800&q=80",
  "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=800&q=80",
];

const articles = [
  {
    title: "Minimalist Home Design: Less is More",
    excerpt: "Discover how to create a peaceful, clutter-free living space with minimalist design principles.",
    image: "https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=800&q=80",
    date: "Nov 18, 2024",
    readTime: "7 min read",
    author: "Interior Designer",
    slug: "minimalist-home-design"
  },
  {
    title: "Smart Home Technology: A Beginner's Guide",
    excerpt: "Transform your home into a smart home with these essential devices and automation tips.",
    image: "https://images.unsplash.com/photo-1558002038-1055907df827?w=800&q=80",
    date: "Nov 16, 2024",
    readTime: "8 min read",
    author: "Tech Expert",
    slug: "smart-home-guide"
  },
  {
    title: "Small Space Solutions: Maximize Your Living Area",
    excerpt: "Creative ideas and storage solutions to make the most of compact living spaces.",
    image: "https://images.unsplash.com/photo-1556912167-f556f1f39faa?w=800&q=80",
    date: "Nov 13, 2024",
    readTime: "6 min read",
    author: "Space Planner",
    slug: "small-space-solutions"
  },
  {
    title: "Color Psychology in Home Decor",
    excerpt: "Learn how different colors affect mood and atmosphere in your home.",
    image: "https://images.unsplash.com/photo-1615873968403-89e068629265?w=800&q=80",
    date: "Nov 10, 2024",
    readTime: "6 min read",
    author: "Color Expert",
    slug: "color-psychology-home"
  },
  {
    title: "Indoor Plants: The Complete Care Guide",
    excerpt: "Bring life to your home with these easy-to-care-for indoor plants and maintenance tips.",
    image: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=800&q=80",
    date: "Nov 8, 2024",
    readTime: "7 min read",
    author: "Plant Expert",
    slug: "indoor-plants-guide"
  },
  {
    title: "Sustainable Home: Eco-Friendly Living Tips",
    excerpt: "Make your home more environmentally friendly with these sustainable living practices.",
    image: "https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=800&q=80",
    date: "Nov 5, 2024",
    readTime: "8 min read",
    author: "Eco Expert",
    slug: "sustainable-home-guide"
  },
  {
    title: "Lighting Design: Illuminate Your Space Perfectly",
    excerpt: "Master the art of home lighting with layered lighting techniques and fixture selection.",
    image: "https://images.unsplash.com/photo-1513506003901-1e6a229e2d15?w=800&q=80",
    date: "Nov 2, 2024",
    readTime: "7 min read",
    author: "Lighting Designer",
    slug: "lighting-design-guide"
  },
  {
    title: "DIY Home Improvement Projects for Beginners",
    excerpt: "Easy DIY projects that will upgrade your home without breaking the bank.",
    image: "https://images.unsplash.com/photo-1581858726788-75bc0f6a952d?w=800&q=80",
    date: "Oct 30, 2024",
    readTime: "9 min read",
    author: "DIY Expert",
    slug: "diy-home-projects"
  },
];
---

<Layout title="Home & Decor Articles - InfoProds" description="Explore home design ideas, decor tips, and interior inspiration.">
  <main>
    <!-- Hero with Diagonal Image Carousel -->
    <section class="relative overflow-hidden bg-gradient-to-r from-amber-900/50 to-yellow-900/50 py-8">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-12 items-center gap-0">
          
          <!-- Left: Diagonal White Image Carousel -->
          <div class="col-span-5 relative h-64 ml-6">
            <!-- White Diagonal Shape with Images Inside -->
            <div class="absolute inset-0 bg-white transform -skew-x-12 origin-left shadow-2xl overflow-hidden">
              <!-- Carousel Images - Fill entire diagonal shape -->
              <div id="carousel" class="relative h-full w-full">
                {featuredImages.map((image, index) => (
                  <div 
                    class={`carousel-slide absolute inset-0 transition-opacity duration-700 ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
                  >
                    <img 
                      src={image} 
                      alt="Featured Article"
                      class="w-full h-full object-cover transform scale-110"
                    />
                  </div>
                ))}
              </div>

              <!-- Indicators -->
              <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 z-20">
                {featuredImages.map((_, index) => (
                  <button 
                    class={`carousel-indicator w-2 h-2 rounded-full transition-all ${index === 0 ? 'bg-white w-8' : 'bg-white/50'}`}
                    data-index={index}
                  />
                ))}
              </div>
            </div>
          </div>

          <!-- Right: Text -->
          <div class="col-span-7 pl-12">
            <h1 class="text-5xl font-bold mb-3">
              Home & Decor
            </h1>
            <p class="text-lg text-gray-300">
              Transform your living space with expert design tips and creative ideas
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- Articles Grid -->
    <section class="py-2 -mt-4">
      <div class="container mx-auto px-4">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-4xl font-bold mb-1">Latest Articles</h2>
            <p class="text-gray-400 text-sm">Expert interior design and home improvement advice</p>
          </div>
          <div class="flex gap-3">
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">
              Filter
            </button>
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">
              Sort
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {articles.map((article) => (
            <article class="group bg-white/5 rounded-2xl overflow-hidden border border-white/10 hover:border-amber-500/50 transition-all hover:scale-105">
              <div class="relative h-40 overflow-hidden">
                <img 
                  src={article.image} 
                  alt={article.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 bg-amber-600 rounded-full text-xs font-semibold">
                    Home
                  </span>
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-2 text-sm text-gray-400 mb-3">
                  <span>{article.date}</span>
                  <span>•</span>
                  <span>{article.readTime}</span>
                </div>

                <h3 class="text-xl font-bold mb-3 group-hover:text-amber-400 transition line-clamp-2">
                  {article.title}
                </h3>
                
                <p class="text-gray-300 text-sm mb-4 line-clamp-2">
                  {article.excerpt}
                </p>

                <div class="flex items-center justify-between">
                  <span class="text-xs text-gray-500">{article.author}</span>
                  <a 
                    href={`/blog/${article.slug}`}
                    class="text-amber-400 hover:text-amber-300 text-sm font-semibold"
                  >
                    Read More →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center mt-12">
          <button class="px-8 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Load More Articles
          </button>
        </div>
      </div>
    </section>

    <!-- Featured Guides -->
    <section class="py-16 bg-black/20">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Popular Home Guides</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-amber-500/10 to-yellow-500/10 rounded-2xl p-6 border border-amber-500/20">
            <div class="text-4xl mb-4">🏠</div>
            <h3 class="text-xl font-bold mb-2">Room Makeovers</h3>
            <p class="text-gray-300 text-sm mb-4">Transform any room with style and functionality</p>
            <a href="#" class="text-amber-400 hover:text-amber-300 text-sm font-semibold">
              Explore →
            </a>
          </div>

          <div class="bg-gradient-to-br from-yellow-500/10 to-orange-500/10 rounded-2xl p-6 border border-yellow-500/20">
            <div class="text-4xl mb-4">🎨</div>
            <h3 class="text-xl font-bold mb-2">Design Styles</h3>
            <p class="text-gray-300 text-sm mb-4">Explore different interior design aesthetics</p>
            <a href="#" class="text-yellow-400 hover:text-yellow-300 text-sm font-semibold">
              Explore →
            </a>
          </div>

          <div class="bg-gradient-to-br from-orange-500/10 to-amber-500/10 rounded-2xl p-6 border border-orange-500/20">
            <div class="text-4xl mb-4">🛋️</div>
            <h3 class="text-xl font-bold mb-2">Furniture Guides</h3>
            <p class="text-gray-300 text-sm mb-4">Choose the perfect furniture for your space</p>
            <a href="#" class="text-orange-400 hover:text-orange-300 text-sm font-semibold">
              Explore →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-r from-amber-900/30 to-yellow-900/30">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Explore More Categories</h2>
        <p class="text-gray-300 mb-6">Discover articles about kitchen essentials, gifts, tech, and more</p>
        <div class="flex justify-center gap-4 flex-wrap">
          <a href="/categories/kitchen" class="px-6 py-3 bg-green-600 hover:bg-green-700 rounded-lg font-semibold transition">
            Kitchen
          </a>
          <a href="/categories/tech-gadgets" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Tech Gadgets
          </a>
          <a href="/categories/gifts" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Gifts
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Carousel Script -->
  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.carousel-slide');
    const indicators = document.querySelectorAll('.carousel-indicator');
    const totalSlides = slides.length;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('opacity-100', i === index);
        slide.classList.toggle('opacity-0', i !== index);
      });

      indicators.forEach((indicator, i) => {
        if (i === index) {
          indicator.classList.add('bg-white', 'w-8');
          indicator.classList.remove('bg-white/50', 'w-2');
        } else {
          indicator.classList.remove('bg-white', 'w-8');
          indicator.classList.add('bg-white/50', 'w-2');
        }
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      showSlide(currentSlide);
    }

    setInterval(nextSlide, 4000);

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentSlide = index;
        showSlide(currentSlide);
      });
    });
  </script>
</Layout>