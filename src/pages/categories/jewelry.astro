  },
  {
    title: "How to Clean and Care for Your Fine Jewelry",
    excerpt: "Essential tips for maintaining the beauty and longevity of your precious jewelry pieces.",
    image: "https://images.unsplash.com/photo-1573408301185-9146fe634ad0?w=800&q=80",
    date: "Nov 17, 2024",
    readTime: "6 min read",
    author: "Jewelry Expert",
    slug: "jewelry-care-guide"
  },
  {
    title: "Gold vs Silver vs Platinum: Which Metal is Right for You?",
    excerpt: "Compare different precious metals and discover which one suits your style and budget.",
    image: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=800&q=80",
    date: "Nov 14, 2024",
    readTime: "7 min read",
    author: "Metal Expert",
    slug: "precious-metals-comparison"
  },
  {
    title: "Building Your Jewelry Collection: Essential Pieces",
    excerpt: "Discover the must-have jewelry pieces every collection should include, from timeless classics to modern staples.",
    image: "https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=800&q=80",
    date: "Nov 11, 2024",
    readTime: "6 min read",
    author: "Style Guide",
    slug: "essential-jewelry-collection"
  },
  {
    title: "Birthstones Guide: Meanings, Colors, and Symbolism",
    excerpt: "Explore the history and significance of birthstones for each month of the year.",
    image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=800&q=80",
    date: "Nov 9, 2024",
    readTime: "7 min read",
    author: "Gemstone Expert",
    slug: "birthstones-guide"
  },
  {
    title: "Vintage Jewelry: How to Authenticate and Value Antique Pieces",
    excerpt: "Learn to identify genuine vintage jewelry and understand what makes these pieces valuable.",
    image: "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=800&q=80",
    date: "Nov 6, 2024",
    readTime: "8 min read",
    author: "Antique Expert",
    slug: "vintage-jewelry-guide"
  },
  {
    title: "Engagement Ring Styles: Find Your Perfect Match",
    excerpt: "From solitaire to halo settings, explore different engagement ring styles and find the one that speaks to you.",
    image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=800&q=80",
    date: "Nov 4, 2024",
    readTime: "9 min read",
    author: "Bridal Expert",
    slug: "engagement-ring-styles"
  },
  {
    title: "Sustainable Jewelry: Ethical Sourcing and Lab-Grown Gems",
    excerpt: "Discover eco-friendly jewelry options and learn about ethical sourcing in the jewelry industry.",
    image: "https://images.unsplash.com/photo-1603561596112-0a132b757442?w=800&q=80",
    date: "Nov 1, 2024",
    readTime: "7 min read",
    author: "Ethical Jewelry",
    slug: "sustainable-jewelry-guide"
  },
];
---

<Layout title="Jewelry & Accessories Articles - InfoProds" description="Discover jewelry guides, gemstone information, and care tips.">
  <main>
    <!-- Hero with Diagonal Image Carousel -->
    <section class="relative overflow-hidden bg-gradient-to-r from-purple-900/50 to-indigo-900/50 py-8">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-12 items-center gap-0">
          
          <!-- Left: Diagonal White Image Carousel -->
          <div class="col-span-5 relative h-64 ml-6">
            <!-- White Diagonal Shape with Images Inside -->
            <div class="absolute inset-0 bg-white transform -skew-x-12 origin-left shadow-2xl overflow-hidden">
              <!-- Carousel Images - Fill entire diagonal shape -->
              <div id="carousel" class="relative h-full w-full">
                {featuredImages.map((image, index) => (
                  <div 
                    class={`carousel-slide absolute inset-0 transition-opacity duration-700 ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
                  >
                    <img 
                      src={image} 
                      alt="Featured Article"
                      class="w-full h-full object-cover transform scale-110"
                    />
                  </div>
                ))}
              </div>

              <!-- Indicators -->
              <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 z-20">
                {featuredImages.map((_, index) => (
                  <button 
                    class={`carousel-indicator w-2 h-2 rounded-full transition-all ${index === 0 ? 'bg-white w-8' : 'bg-white/50'}`}
                    data-index={index}
                  />
                ))}
              </div>
            </div>
          </div>

          <!-- Right: Text -->
          <div class="col-span-7 pl-12">
            <h1 class="text-5xl font-bold mb-3">
              Jewelry & Accessories
            </h1>
            <p class="text-lg text-gray-300">
              Your guide to fine jewelry, gemstones, and timeless accessories
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- Articles Grid -->
    <section class="py-2 -mt-4">
      <div class="container mx-auto px-4">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-4xl font-bold mb-1">Latest Articles</h2>
            <p class="text-gray-400 text-sm">Expert jewelry advice and gemstone guides</p>
          </div>
          <div class="flex gap-3">
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">
              Filter
            </button>
            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition text-sm">
              Sort
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {articles.map((article) => (
            <article class="group bg-white/5 rounded-2xl overflow-hidden border border-white/10 hover:border-purple-500/50 transition-all hover:scale-105">
              <div class="relative h-40 overflow-hidden">
                <img 
                  src={article.image} 
                  alt={article.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 bg-purple-600 rounded-full text-xs font-semibold">
                    Jewelry
                  </span>
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-2 text-sm text-gray-400 mb-3">
                  <span>{article.date}</span>
                  <span>•</span>
                  <span>{article.readTime}</span>
                </div>

                <h3 class="text-xl font-bold mb-3 group-hover:text-purple-400 transition line-clamp-2">
                  {article.title}
                </h3>
                
                <p class="text-gray-300 text-sm mb-4 line-clamp-2">
                  {article.excerpt}
                </p>

                <div class="flex items-center justify-between">
                  <span class="text-xs text-gray-500">{article.author}</span>
                  <a 
                    href={`/blog/${article.slug}`}
                    class="text-purple-400 hover:text-purple-300 text-sm font-semibold"
                  >
                    Read More →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center mt-12">
          <button class="px-8 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Load More Articles
          </button>
        </div>
      </div>
    </section>

    <!-- Featured Guides -->
    <section class="py-16 bg-black/20">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Popular Jewelry Guides</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-purple-500/10 to-indigo-500/10 rounded-2xl p-6 border border-purple-500/20">
            <div class="text-4xl mb-4">💎</div>
            <h3 class="text-xl font-bold mb-2">Gemstone Education</h3>
            <p class="text-gray-300 text-sm mb-4">Learn about different gemstones and their properties</p>
            <a href="#" class="text-purple-400 hover:text-purple-300 text-sm font-semibold">
              Explore →
            </a>
          </div>

          <div class="bg-gradient-to-br from-indigo-500/10 to-purple-500/10 rounded-2xl p-6 border border-indigo-500/20">
            <div class="text-4xl mb-4">💍</div>
            <h3 class="text-xl font-bold mb-2">Buying Guides</h3>
            <p class="text-gray-300 text-sm mb-4">Smart tips for purchasing fine jewelry</p>
            <a href="#" class="text-indigo-400 hover:text-indigo-300 text-sm font-semibold">
              Explore →
            </a>
          </div>

          <div class="bg-gradient-to-br from-violet-500/10 to-purple-500/10 rounded-2xl p-6 border border-violet-500/20">
            <div class="text-4xl mb-4">✨</div>
            <h3 class="text-xl font-bold mb-2">Care & Maintenance</h3>
            <p class="text-gray-300 text-sm mb-4">Keep your jewelry looking beautiful forever</p>
            <a href="#" class="text-violet-400 hover:text-violet-300 text-sm font-semibold">
              Explore →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-r from-purple-900/30 to-indigo-900/30">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Explore More Categories</h2>
        <p class="text-gray-300 mb-6">Discover articles about fashion, beauty, gifts, and more</p>
        <div class="flex justify-center gap-4 flex-wrap">
          <a href="/categories/fashion" class="px-6 py-3 bg-pink-600 hover:bg-pink-700 rounded-lg font-semibold transition">
            Fashion
          </a>
          <a href="/categories/gifts" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Gifts
          </a>
          <a href="/categories/beauty" class="px-6 py-3 bg-white/10 hover:bg-white/20 rounded-lg font-semibold transition border border-white/20">
            Beauty
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Carousel Script -->
  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.carousel-slide');
    const indicators = document.querySelectorAll('.carousel-indicator');
    const totalSlides = slides.length;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('opacity-100', i === index);
        slide.classList.toggle('opacity-0', i !== index);
      });

      indicators.forEach((indicator, i) => {
        if (i === index) {
          indicator.classList.add('bg-white', 'w-8');
          indicator.classList.remove('bg-white/50', 'w-2');
        } else {
          indicator.classList.remove('bg-white', 'w-8');
          indicator.classList.add('bg-white/50', 'w-2');
        }
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      showSlide(currentSlide);
    }

    setInterval(nextSlide, 4000);

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentSlide = index;
        showSlide(currentSlide);
      });
    });
  </script>
</Layout>