---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  const categories = [...new Set(blogPosts.map(post => post.data.category))];
  
  return categories.map(category => ({
    params: { category: category.toLowerCase().replace(/\s+/g, '-') },
    props: { 
      category,
      posts: blogPosts.filter(post => post.data.category === category)
    },
  }));
}

const { category, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout 
  title={`${category} - InfoProds`}
  description={`Explore the latest ${category.toLowerCase()} articles, trends, and guides on InfoProds`}
>
  <section class="bg-gradient-to-br from-purple-600 via-blue-600 to-indigo-700 text-white py-20">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4">{category}</h1>
      <p class="text-xl text-gray-200">Expert {category.toLowerCase()} advice and trend analysis</p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    {sortedPosts.length === 0 ? (
      <div class="text-center py-20">
        <p class="text-xl text-gray-400">No articles yet in this category. Check back soon!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <article class="bg-gray-800 rounded-lg overflow-hidden hover:transform hover:scale-105 transition-all duration-300 shadow-lg">
            {post.data.image && (
              <img 
                src={post.data.image} 
                alt={post.data.title}
                class="w-full h-48 object-cover"
              />
            )}
            <div class="p-6">
              <span class="text-xs text-purple-400 font-semibold uppercase tracking-wide">
                {post.data.category}
              </span>
              <h2 class="text-xl font-bold mt-2 mb-3 text-white hover:text-purple-400 transition-colors">
                <a href={`/blog/${post.slug}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="text-gray-300 text-sm mb-4 line-clamp-3">
                {post.data.description}
              </p>
              <div class="flex items-center justify-between text-sm text-gray-400">
                <span>{post.data.author}</span>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'short', 
                    day: 'numeric' 
                  })}
                </time>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>