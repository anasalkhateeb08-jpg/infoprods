---

<Layout
  title={`${category} - InfoProds`}
  description={`Explore the latest ${category.toLowerCase()} articles, trends, and guides on InfoProds`}
>
  <section class={`relative bg-gradient-to-br ${style.gradient} before:absolute before:inset-0 before:z-0 after:absolute after:inset-0 after:z-0 text-white py-12 overflow-hidden`} style={`background-image: radial-gradient(circle at 30% 50%, ${style.glow1}, transparent 50%), radial-gradient(circle at 70% 80%, ${style.glow2}, transparent 50%);`}>
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
        <div class="relative flex items-center justify-center lg:justify-start">
          <div class="diamond-wrapper">
            <div class="diamond-shape">
              {images.map((image, index) => (
                <img 
                  src={image} 
                  alt={`${category} ${index + 1}`}
                  class={`diamond-img ${index === 0 ? 'active' : ''}`}
                />
              ))}
            </div>
          </div>
        </div>
        <div class="text-center lg:text-left">
          <h1 class="text-5xl md:text-6xl font-bold mb-6">{category}</h1>
          <p class="text-xl text-gray-200 leading-relaxed">
            Expert {category.toLowerCase()} advice and trend analysis
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    {sortedPosts.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-xl text-gray-400">No articles yet in this category. Check back soon!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <article class="bg-gray-800 rounded-lg overflow-hidden hover:transform hover:scale-105 transition-all duration-300 shadow-lg">
            {post.data.image && (
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-48 object-cover"
              />
            )}
            <div class="p-6">
              <span class="text-xs text-purple-400 font-semibold uppercase tracking-wide">
                {post.data.category}
              </span>
              <h2 class="text-xl font-bold mt-2 mb-3 text-white hover:text-purple-400 transition-colors">
                <a href={`/blog/${post.slug}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="text-gray-300 text-sm mb-4 line-clamp-3">
                {post.data.description}
              </p>
              <div class="flex items-center justify-between text-sm text-gray-400">
                <span>{post.data.author}</span>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  <style>
    .diamond-wrapper {
      position: relative;
      width: 600px;
      height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .diamond-shape {
      position: relative;
      width: 550px;
      height: 170px;
      overflow: hidden;
      transform: skewX(-20deg);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      border: 3px solid rgba(255, 255, 255, 0.3);
      border-radius: 15px;
    }

    .diamond-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: skewX(20deg) scale(1.3);
      opacity: 0;
      transition: opacity 1s ease-in-out;
    }

    .diamond-img.active {
      opacity: 1;
    }

    @media (max-width: 1024px) {
      .diamond-wrapper {
        width: 500px;
        height: 180px;
      }
      
      .diamond-shape {
        width: 450px;
        height: 150px;
      }
    }

    @media (max-width: 640px) {
      .diamond-wrapper {
        width: 350px;
        height: 130px;
      }
      
      .diamond-shape {
        width: 320px;
        height: 110px;
      }
    }
  </style>

  <script>
    let currentIndex = 0;
    const images = document.querySelectorAll('.diamond-img');
    const totalImages = images.length;

    function rotateImages() {
      images[currentIndex].classList.remove('active');
      currentIndex = (currentIndex + 1) % totalImages;
      images[currentIndex].classList.add('active');
    }

    setInterval(rotateImages, 3000);
  </script>
</Layout>
