  },
  {
    title: "Personalized Gifts: Make It Meaningful",
    excerpt: "Discover creative ideas for customized gifts that show how much you care.",
    image: "https://images.unsplash.com/photo-1549465220-1a8b9238cd48?w=800&q=80",
    date: "Nov 13, 2024",
    readTime: "7 min read",
    author: "Personalization Pro",
    slug: "personalized-gifts-guide"
  },
  {
    title: "Tech Gifts for Gadget Lovers: 2024 Edition",
    excerpt: "The hottest tech gadgets and innovative devices that make perfect gifts.",
    image: "https://images.unsplash.com/photo-1512909006721-3d6018887383?w=800&q=80",
    date: "Nov 10, 2024",
    readTime: "8 min read",
    author: "Tech Gifting",
    slug: "tech-gifts-2024"
  },
  {
    title: "Budget-Friendly Gift Ideas That Look Expensive",
    excerpt: "Thoughtful and impressive gifts that won't break the bank but feel luxurious.",
    image: "https://images.unsplash.com/photo-1550258987-190a2d41a8ba?w=800&q=80",
    date: "Nov 7, 2024",
    readTime: "6 min read",
    author: "Budget Gifting",
    slug: "budget-gift-ideas"
  },
  {
    title: "Last-Minute Gift Ideas: Quick and Thoughtful",
    excerpt: "Running out of time? These last-minute gift ideas are both quick and meaningful.",
    image: "https://images.unsplash.com/photo-1549465220-1a8b9238cd48?w=800&q=80",
    date: "Nov 4, 2024",
    readTime: "5 min read",
    author: "Quick Gifts",
    slug: "last-minute-gifts"
  },
  {
    title: "Experience Gifts: Create Lasting Memories",
    excerpt: "Move beyond material gifts and give experiences that create unforgettable memories.",
    image: "https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?w=800&q=80",
    date: "Nov 1, 2024",
    readTime: "7 min read",
    author: "Experience Expert",
    slug: "experience-gifts-guide"
  },
  {
    title: "Corporate Gifts: Professional and Memorable",
    excerpt: "Navigate the world of business gifting with these appropriate and impressive ideas.",
    image: "https://images.unsplash.com/photo-1532618793091-ec5fe9635fbd?w=800&q=80",
    date: "Oct 29, 2024",
    readTime: "6 min read",
    author: "Corporate Gifting",
    slug: "corporate-gifts-guide"
  },
  {
    title: "Sustainable Gifts: Eco-Friendly Options",
    excerpt: "Give gifts that are kind to the planet with these sustainable and eco-conscious options.",
    image: "https://images.unsplash.com/photo-1513885535751-8b9238bd345a?w=800&q=80",
    date: "Oct 26, 2024",
    readTime: "8 min read",
