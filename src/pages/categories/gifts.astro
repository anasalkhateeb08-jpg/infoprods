];

const articles = [
  {
    title: "The Ultimate Gift Guide for Every Occasion",
    excerpt: "Find the perfect gift for birthdays, anniversaries, holidays, and special celebrations.",
    image: "https://images.unsplash.com/photo-1513885535751-8b9238bd345a?w=800&q=80",
