const featuredImages = [
  "https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=800&q=80",
  "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=800&q=80",
  "https://images.unsplash.com/photo-1487412947147-5cebf100ffc2?w=800&q=80",
  "https://images.unsplash.com/photo-1512496015851-a90fb38ba796?w=800&q=80",
];

const articles = [
  {
    title: "Skincare Routine 101: Morning and Night Essentials",
    excerpt: "Build the perfect skincare routine with these essential steps for healthy, glowing skin.",
    image: "https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=800&q=80",
    date: "Nov 17, 2024",
    readTime: "8 min read",
    author: "Dermatologist",
    slug: "skincare-routine-guide"
  },
  {
    title: "The Ultimate Guide to Finding Your Skin Type",
    excerpt: "Learn how to identify your skin type and choose the right products for your unique needs.",
    image: "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=800&q=80",
    date: "Nov 14, 2024",
    readTime: "6 min read",
    author: "Skin Expert",
    slug: "skin-type-guide"
  },
  {
    title: "Anti-Aging Skincare: Ingredients That Actually Work",
    excerpt: "Discover proven anti-aging ingredients and how to incorporate them into your routine.",
    image: "https://images.unsplash.com/photo-1487412947147-5cebf100ffc2?w=800&q=80",
    date: "Nov 11, 2024",
    readTime: "9 min read",
    author: "Anti-Aging Expert",
    slug: "anti-aging-ingredients"
  },
  {
    title: "Makeup Basics: A Beginner's Complete Guide",
    excerpt: "Master the fundamentals of makeup application with this comprehensive beginner's guide.",
    image: "https://images.unsplash.com/photo-1512496015851-a90fb38ba796?w=800&q=80",
    date: "Nov 8, 2024",
    readTime: "10 min read",
    author: "Makeup Artist",
    slug: "makeup-basics-guide"
  },
  {
    title: "Natural Beauty: DIY Face Masks from Kitchen Ingredients",
    excerpt: "Create effective, natural face masks using ingredients you already have at home.",
    image: "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=800&q=80",
    date: "Nov 5, 2024",
    readTime: "6 min read",
    author: "Natural Beauty",
    slug: "diy-face-masks"
  },
  {
    title: "Hair Care Essentials: From Washing to Styling",
    excerpt: "Complete guide to maintaining healthy, beautiful hair with proper care and styling techniques.",
    image: "https://images.unsplash.com/photo-1522338242992-e1a54906a8da?w=800&q=80",
    date: "Nov 2, 2024",
    readTime: "8 min read",
    author: "Hair Specialist",
    slug: "hair-care-guide"
  },
  {
    title: "Clean Beauty: Understanding Product Labels and Ingredients",
    excerpt: "Learn to decode beauty product labels and make informed choices for cleaner beauty.",
    image: "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=800&q=80",
    date: "Oct 30, 2024",
    readTime: "7 min read",
    author: "Clean Beauty Expert",
    slug: "clean-beauty-guide"
  },
  {
    title: "Sun Protection: The Most Important Step in Skincare",
    excerpt: "Everything you need to know about sunscreen, SPF, and protecting your skin from UV damage.",
    image: "https://images.unsplash.com/photo-1571875257727-256c39da42af?w=800&q=80",
    date: "Oct 27, 2024",
    readTime: "7 min read",
    author: "UV Protection Expert",
    slug: "sun-protection-guide"
  },
