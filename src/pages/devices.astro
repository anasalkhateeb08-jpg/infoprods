---
import Layout from '../layouts/Layout.astro';

const deviceCategories = [
  {
    name: "Smartphones",
    icon: "📱",
    count: "50+ Devices",
    images: [
      "https://images.unsplash.com/photo-1592286927505-2fd7da2a7b7c?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1598327105666-5b89351aff97?w=800&h=600&fit=crop"
    ],
    link: "/devices/smartphones"
  },
  {
    name: "Laptops",
    icon: "💻",
    count: "40+ Devices",
    images: [
      "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?w=800&h=600&fit=crop"
    ],
    link: "/devices/laptops"
  },
  {
    name: "Tablets",
    icon: "📲",
    count: "30+ Devices",
    images: [
      "https://images.unsplash.com/photo-1561154464-82e9adf32764?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1585790050230-5dd28404ccb9?w=800&h=600&fit=crop"
    ],
    link: "/devices/tablets"
  },
  {
    name: "Gaming Consoles",
    icon: "🎮",
    count: "15+ Devices",
    images: [
      "https://images.unsplash.com/photo-1486401899868-0e435ed85128?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1606144042614-b2417e99c4e3?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1622297845775-5ff3fef71d13?w=800&h=600&fit=crop"
    ],
    link: "/devices/gaming-consoles"
  },
  {
    name: "Cameras",
    icon: "📷",
    count: "35+ Devices",
    images: [
      "https://images.unsplash.com/photo-1502920917128-1aa500764cbd?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1606983340126-99ab4feaa64a?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=800&h=600&fit=crop"
    ],
    link: "/devices/cameras"
  },
  {
    name: "Smartwatches",
    icon: "⌚",
    count: "25+ Devices",
    images: [
      "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1579586337278-3befd40fd17a?w=800&h=600&fit=crop",
      "https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?w=800&h=600&fit=crop"
    ],
    link: "/devices/smartwatches"
  }
];
---

<Layout title="DeviceSpecs - InfoProds" description="Comprehensive device database with detailed specs and comparisons">
  <main>
    
    <!-- Hero Section - Same as Categories pages -->
    <section class="relative h-[300px] flex items-center justify-center overflow-hidden">
      
      <!-- Background Image -->
      <img 
        src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=1920&h=1080&fit=crop" 
        alt="Technology Devices"
        class="absolute inset-0 w-full h-full object-cover"
      />
      
      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/80"></div>
      
      <!-- Content -->
      <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
        
        <!-- Title -->
        <h1 class="text-6xl md:text-7xl font-black mb-6 bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
          DeviceSpecs
        </h1>
        
        <!-- Description -->
        <p class="text-xl md:text-2xl text-gray-200 mb-8 leading-relaxed">
          Your comprehensive device database with detailed specs, intelligent comparisons, and smart recommendations
        </p>
        
        <!-- Stats -->
        <div class="flex justify-center gap-12 flex-wrap">
          <div class="text-center">
            <div class="text-5xl font-black bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">
              200+
            </div>
            <div class="text-sm text-gray-300 mt-2 font-semibold">Devices</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-black bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
              6
            </div>
            <div class="text-sm text-gray-300 mt-2 font-semibold">Categories</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-black bg-gradient-to-r from-orange-400 to-red-400 bg-clip-text text-transparent">
              AI
            </div>
            <div class="text-sm text-gray-300 mt-2 font-semibold">Powered</div>
          </div>
        </div>
        
      </div>
      
    </section>

    <!-- Categories Grid -->
    <section class="py-8 px-4">
      <div class="container mx-auto">
        
        <h2 class="text-3xl font-bold text-center mb-12">Browse by Category</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {deviceCategories.map((category, index) => (
            <a 
              href={category.link}
              class="group relative h-54 rounded-3xl overflow-hidden hover:scale-105 transition-all duration-500 shadow-xl hover:shadow-2xl"
            >
              
              <!-- Image Carousel Container -->
              <div class="carousel-container absolute inset-0" data-category={index}>
                {category.images.map((img, imgIndex) => (
                  <img 
                    src={img} 
                    alt={`${category.name} ${imgIndex + 1}`}
                    class={`carousel-image absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${imgIndex === 0 ? 'opacity-100' : 'opacity-0'}`}
                    data-index={imgIndex}
                  />
                ))}
              </div>
              
              <!-- Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
              
              <!-- Content -->
              <div class="absolute bottom-0 left-0 right-0 p-6">
                
                <!-- Icon -->
                <div class="text-5xl mb-3 group-hover:scale-125 group-hover:-translate-y-2 transition-all duration-500">
                  {category.icon}
                </div>
                
                <!-- Title -->
                <h3 class="text-2xl font-bold mb-2 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-cyan-400 group-hover:to-purple-400 group-hover:bg-clip-text transition-all">
                  {category.name}
                </h3>
                
                <!-- Count -->
                <p class="text-sm text-gray-300">{category.count}</p>
                
              </div>
              
              <!-- Hover Border Effect -->
              <div class="absolute inset-0 border-2 border-transparent group-hover:border-purple-500/50 rounded-3xl transition-all duration-500"></div>
              
            </a>
          ))}
        </div>
        
      </div>
    </section>

  </main>

  <!-- Carousel Script -->
  <script>
    // Auto-rotate images every 3 seconds
    function startCarousel() {
      const containers = document.querySelectorAll('.carousel-container');
      
      containers.forEach((container) => {
        const images = container.querySelectorAll('.carousel-image');
        let currentIndex = 0;
        
        setInterval(() => {
          // Hide current image
          images[currentIndex].classList.remove('opacity-100');
          images[currentIndex].classList.add('opacity-0');
          
          // Show next image
          currentIndex = (currentIndex + 1) % images.length;
          images[currentIndex].classList.remove('opacity-0');
          images[currentIndex].classList.add('opacity-100');
        }, 3000); // Change every 3 seconds
      });
    }
    
    // Start carousel when page loads
    document.addEventListener('DOMContentLoaded', startCarousel);
  </script>
</Layout>