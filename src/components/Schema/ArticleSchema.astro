---
interface Props {
  title: string;
  description: string;
  image: string;
  date: Date;
  author?: string;
  url: string;
  category?: string;
  tags?: string[];
}

const { 
  title, 
  description, 
  image, 
  date, 
  author = "InfoProds Team",
  url,
  category,
  tags = []
} = Astro.props;

const fullImageUrl = image.startsWith("http") ? image : "https://infoprods.com" + image;

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": {
    "@type": "ImageObject",
    "url": fullImageUrl,
    "width": 1200,
    "height": 630
  },
  "datePublished": date.toISOString(),
  "dateModified": date.toISOString(),
  "author": {
    "@type": "Person",
    "name": author,
    "url": "https://infoprods.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "InfoProds",
    "logo": {
      "@type": "ImageObject",
      "url": "https://infoprods.com/logo.png",
      "width": 250,
      "height": 60
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": url
  }
};

if (category) {
  schema["articleSection"] = category;
}

if (tags && tags.length > 0) {
  schema["keywords"] = tags.join(", ");
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />