---
interface ProductReview {
  author: string;
  datePublished: string;
  reviewBody: string;
  reviewRating: {
    ratingValue: number;
    bestRating?: number;
  };
}

interface Props {
  name?: string;
  description?: string;
  image?: string;
  brand?: string;
  sku?: string;
  aggregateRating?: {
    ratingValue: number;
    reviewCount: number;
    bestRating?: number;
  };
  offers?: {
    url: string;
    priceCurrency: string;
    price: string;
    availability?: string;
  };
  review?: ProductReview;
}

const { name, description, image, brand, sku, aggregateRating, offers, review } = Astro.props;

// إذا لم يكن هناك معلومات المنتج، لا تعرض شيء
if (!name) {
  return null;
}

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": name,
  ...(description && { "description": description }),
  ...(image && { "image": image }),
  ...(brand && { 
    "brand": {
      "@type": "Brand",
      "name": brand
    }
  }),
  ...(sku && { "sku": sku }),
  ...(aggregateRating && {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": aggregateRating.ratingValue,
      "reviewCount": aggregateRating.reviewCount,
      "bestRating": aggregateRating.bestRating || 5
    }
  }),
  ...(offers && {
    "offers": {
      "@type": "Offer",
      "url": offers.url,
      "priceCurrency": offers.priceCurrency,
      "price": offers.price,
      "availability": offers.availability || "https://schema.org/InStock"
    }
  }),
  ...(review && {
    "review": {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": review.author
      },
      "datePublished": review.datePublished,
      "reviewBody": review.reviewBody,
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": review.reviewRating.ratingValue,
        "bestRating": review.reviewRating.bestRating || 5
      }
    }
  })
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
