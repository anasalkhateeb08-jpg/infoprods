<footer class="bg-black/40 border-t border-white/10 py-12">
  <div class="container mx-auto px-4">
    
    <!-- Newsletter Section -->
    <div class="mb-12 bg-gradient-to-r from-purple-900/30 to-blue-900/30 rounded-2xl p-8 border border-white/10">
      <div class="max-w-2xl mx-auto text-center">
        <h3 class="text-2xl font-bold mb-2">📧 Stay Updated</h3>
        <p class="text-gray-300 mb-6">Get the latest product reviews and recommendations delivered to your inbox!</p>
        
        <!-- Mailchimp Form -->
        <form action="https://infoprods.us14.list-manage.com/subscribe/post?u=31271582e5a8682479ad0e485&id=d43c2cdea4&f_id=009814e0f0" method="post" target="_blank" class="flex flex-col md:flex-row gap-3 justify-center items-center">
          <input 
            type="email" 
            name="EMAIL" 
            placeholder="Enter your email" 
            required
            class="px-4 py-3 rounded-lg bg-white/10 border border-white/20 focus:border-cyan-400 focus:outline-none text-white placeholder-gray-400 w-full md:w-96"
          >
