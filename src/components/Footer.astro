          <li><a href="/categories/car-accessories-&-care" class="text-gray-400 hover:text-white transition text-sm">Car Accessories</a></li>
          <li><a href="/categories/technology-&-devices" class="text-gray-400 hover:text-white transition text-sm">Technology</a></li>
          <li><a href="/categories/home" class="text-gray-400 hover:text-white transition text-sm">Home & Decor</a></li>
          <li><a href="/categories/beauty" class="text-gray-400 hover:text-white transition text-sm">Beauty</a></li>
